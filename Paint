    )

    private data class SnapshotTile(
        val key: TileKey,
        val bitmap: Bitmap,
        val representedRevisions: Map<String, Long>
    )

    private data class RenderSnapshot(
        val width: Int,
        val height: Int,
        val scale: Float,
        val offsetX: Float,
        val offsetY: Float,
        val visibleTiles: Set<TileKey>,
        val tiles: List<SnapshotTile>,
        val strokes: List<JobStroke>
    )
}

private fun tileRect(key: TileKey): RectF {
    val left = key.x * TILE_SIZE
    val top = key.y * TILE_SIZE

    return RectF(
        left.toFloat(),
        top.toFloat(),
        (left + TILE_SIZE).toFloat(),
        (top + TILE_SIZE).toFloat()
    )
}

private fun rectsIntersect(a: RectF, b: RectF): Boolean {
    return a.left < b.right &&
        a.right > b.left &&
        a.top < b.bottom &&
        a.bottom > b.top
}

private fun unionBounds(a: RectF?, b: RectF?): RectF? {
    if (a == null) return b
    if (b == null) return a

    return RectF(
        min(a.left, b.left),
        min(a.top, b.top),
        max(a.right, b.right),
        max(a.bottom, b.bottom)
    )
}

private fun screenBoundsForStroke(
    stroke: StrokeCanvasState.JobStroke,
    scale: Float,
    offsetX: Float,
    offsetY: Float
): RectF? {
    return screenBoundsForPoints(
        points = stroke.points,
        widthPx = stroke.widthPx,
        scale = scale,
        offsetX = offsetX,
        offsetY = offsetY
    )
}

private fun screenBoundsForPoints(
    points: List<StrokePoint>,
    widthPx: Float,
    scale: Float,
    offsetX: Float,
    offsetY: Float
): RectF? {
    if (points.isEmpty()) return null

    var left = Float.POSITIVE_INFINITY
    var top = Float.POSITIVE_INFINITY
    var right = Float.NEGATIVE_INFINITY
    var bottom = Float.NEGATIVE_INFINITY
    var maxPressure = 0f

    for (point in points) {
        val sx = (point.x - offsetX) * scale
        val sy = (point.y - offsetY) * scale

        left = min(left, sx)
        top = min(top, sy)
        right = max(right, sx)
        bottom = max(bottom, sy)
        maxPressure = max(maxPressure, point.pressure)
    }

    val radius = widthPx * maxPressure / 2f

    if (radius <= 0f && left == right && top == bottom) {
        return null
    }

    return RectF(
        left - radius,
        top - radius,
        right + radius,
        bottom + radius
    )
}

data class StrokePoint(
    val x: Float,
    val y: Float,
    val pressure: Float = 1f
)

data class TileKey(
    val x: Int,
    val y: Int
)

data class StrokeCanvasDebugState(
    val sceneGeneration: Long,
    val viewportGeneration: Long,
    val committedTiles: Set<TileKey>,
    val pendingTiles: Set<TileKey>,
    val activeStrokeIds: Set<String>,
    val mainThreadId: Long,
    val commitThreadIds: List<Long>,
    val submittedJobCount: Long,
    val submittedTileKeys: List<TileKey>,
    val rejectedCommitCount: Long,
    val evictedTiles: List<TileKey>
)





Tests
Invalid inputs — Robolectric unit test
Verify invalid maxCachedTiles, invalid viewport values, empty strokeId, invalid stroke width, invalid point coordinates, negative pressure, and invalid snapshot sizes throw IllegalArgumentException.
Compose scheduling only through composition — Compose UI test on Robolectric
Do not call internal scheduling helpers. Compose ConcurrentStrokeCanvas(state, Modifier.size(...)), run Compose/main-thread work, and verify pending jobs appear. Recompose repeatedly with the same state and size and verify no duplicate jobs are submitted.
Missing tile background and nonblocking draw — Compose UI test + Robolectric bitmap assertion
Use a controlled executor that blocks raster jobs. Compose the canvas and verify rendering returns immediately. Verify visible missing tiles draw white background plus only required live overlay.
Single stroke crosses tile boundary — Roborazzi screenshot test
Draw a diagonal stroke crossing multiple tiles. Complete tile jobs out of order. Verify the final screenshot is continuous across tile boundaries.
Input point list is copied — Robolectric unit test + bitmap assertion
Append points, mutate the caller’s list afterward, complete raster jobs, and verify rendering uses the original copied points.
Single-point stroke dot — Roborazzi screenshot test
Create a stroke with one point and nonzero pressure. Verify a round dot appears at the transformed point.
Zero-pressure segment draws nothing — Robolectric bitmap test
Append two points with pressure 0. Verify the segment contributes no non-background pixels.
Append while raster pending rejects stale affected result — Robolectric concurrency test
Begin a stroke, append initial points, schedule tile jobs, then append more points before old jobs finish. Complete old jobs afterward. Verify affected old tile results are rejected and rejectedCommitCount increases.
Unaffected pending job survives stroke mutation — Robolectric concurrency test
Schedule pending jobs for two distant tiles. Mutate a stroke affecting only one tile. Complete both old jobs. Verify the affected job is rejected and the unaffected job commits.
Remove while raster pending — Robolectric concurrency test + bitmap assertion
Schedule jobs for a visible stroke, remove it before workers finish, complete old jobs, and verify the stroke does not reappear.
Restyle invalidates old and new bounds — Roborazzi screenshot test
Restyle a stroke from thin to thick and a different color. Verify tiles intersecting both old and newly expanded bounds are invalidated, old style disappears, and new style appears.
Viewport change rejects stale tiles — Robolectric concurrency test
Schedule jobs under viewport A, call setViewport to viewport B, then complete viewport-A jobs. Verify they are rejected and do not commit.
Visible before prefetch priority — Compose UI test on Robolectric
Compose at a size with visible tiles and a prefetch ring. Verify submittedTileKeys lists all visible tiles in row-major order before any prefetch tile, and prefetch tiles are also row-major.
LRU evicts non-visible first — Robolectric state test
Use a small cache. Render several tiles, pan so some become non-visible, render more tiles, and verify least-recently-used non-visible tiles are evicted before visible tiles.
Visible protection — Robolectric state test
Set maxCachedTiles smaller than the visible tile count. Verify visible tiles survive the current draw even if the cache temporarily exceeds the cap.
Undo/redo stroke lifecycle — Roborazzi screenshot test
Draw strokes A, B, C. Remove B, undo, redo. Verify order is A/B/C after undo and A/C after redo, with only affected tiles invalidated.
Undo append is dirty-only — Robolectric state test + bitmap assertion
Append points that extend a stroke into a new tile, then undo. Verify newly touched tiles are invalidated, but unrelated committed tiles remain reusable.
Undo rejects stale jobs — Robolectric concurrency test
Schedule jobs for a stroke, call undo before workers complete, then complete old jobs. Verify stale affected tiles do not commit.
Live overlay while raster pending — Roborazzi screenshot test
Block workers, append points to an in-progress visible stroke, and capture a screenshot. Verify the new segment appears as a live overlay before any new tile commits. Complete raster jobs and verify the final screenshot does not double-draw.
Stale tile with partially stale stroke set rejected — Robolectric concurrency test
Create a tile job capturing strokes A and B. Mutate only B before the job completes. Complete the old job and verify the whole tile is rejected.
Clear rejects stale workers — Robolectric concurrency test
Schedule jobs, call clear, then complete old jobs. Verify committed tiles remain empty and old strokes do not reappear.
renderSnapshot safety — Robolectric unit test + bitmap assertion
Call renderSnapshot while workers are pending. Verify it returns without waiting, does not schedule jobs, and produces a bitmap from committed tiles plus required live overlay.
Main-thread commit observability — Robolectric concurrency test
Complete raster jobs from worker threads, run pending main-thread tasks, and verify every value in commitThreadIds equals mainThreadId.
Eviction order observable — Robolectric state test
Under small cache pressure, render tiles, read some through renderSnapshot, then pan. Verify evictedTiles shows least-recently-used non-visible tiles evicted first and visible tiles protected.
Dirty-only stress — Robolectric randomized concurrency test
Randomly interleave append, restyle, remove, undo, redo, viewport pan, snapshot, clear, and out-of-order completions. Verify unaffected committed tiles survive, unaffected pending jobs can commit, stale affected jobs are rejected, no duplicate jobs occur, and no deadlocks happen.
Visual regression suite — Roborazzi screenshot test
Capture deterministic screenshots for empty canvas, partial tile commit, full stroke commit, append-while-pending, live overlay, restyle, undo/redo, viewport pan, and cache pressure.

