/* ============================================================
 * PUBLIC API
 * ============================================================ */

@Immutable
data class MorphingTextAnimationSpec(
    val exitDurationMillis: Int = 100,
    val moveDurationMillis: Int = 200,
    val enterDurationMillis: Int = 100,
) {
    init {
        require(exitDurationMillis >= 0) {
            "exitDurationMillis must be >= 0"
        }
        require(moveDurationMillis >= 0) {
            "moveDurationMillis must be >= 0"
        }
        require(enterDurationMillis >= 0) {
            "enterDurationMillis must be >= 0"
        }
    }

    val totalDurationMillis: Int
        get() =
            exitDurationMillis +
                moveDurationMillis +
                enterDurationMillis
}


/**
 * Current animation phase.
 */
enum class MorphPhase {
    Remove,
    Move,
    Insert,
}


fun interface MorphingTextMatcher {
    fun match(
        old: List<Grapheme>,
        new: List<Grapheme>,
    ): List<Match>
}


/* ============================================================
 * DETERMINISTIC MATCHER
 * ============================================================ */

/**
 * Matching priority:
 *
 * 1. Reuse as many graphemes as possible.
 * 2. Minimize total movement.
 * 3. Preserve relative ordering.
 * 4. If still tied, choose the lexicographically smaller
 *    sequence of Match(oldIndex, newIndex).
 */
object MinimumMovementMatcher : MorphingTextMatcher {

    private data class Candidate(
        val matches: List<Match>,
        val movementCost: Int,
    )

    override fun match(
        old: List<Grapheme>,
        new: List<Grapheme>,
    ): List<Match> {

        if (old.isEmpty() || new.isEmpty()) {
            return emptyList()
        }

        val memo =
            HashMap<Pair<Int, Int>, Candidate>()

        fun compareMatches(
            first: List<Match>,
            second: List<Match>,
        ): Int {

            val size =
                minOf(
                    first.size,
                    second.size,
                )

            for (index in 0 until size) {

                val a = first[index]
                val b = second[index]

                if (a.oldIndex != b.oldIndex) {
                    return a.oldIndex.compareTo(
                        b.oldIndex
                    )
                }

                if (a.newIndex != b.newIndex) {
                    return a.newIndex.compareTo(
                        b.newIndex
                    )
                }
            }

            return first.size.compareTo(
                second.size
            )
        }

        fun better(
            first: Candidate,
            second: Candidate,
        ): Candidate {

            if (
                first.matches.size !=
                second.matches.size
            ) {
                return if (
                    first.matches.size >
                    second.matches.size
                ) {
                    first
                } else {
                    second
                }
            }

            if (
                first.movementCost !=
                second.movementCost
            ) {
                return if (
                    first.movementCost <
                    second.movementCost
                ) {
                    first
                } else {
                    second
                }
            }

            return if (
                compareMatches(
                    first.matches,
                    second.matches,
                ) <= 0
            ) {
                first
            } else {
                second
            }
        }

        fun solve(
            oldIndex: Int,
            newIndex: Int,
        ): Candidate {

            if (
                oldIndex >= old.size ||
                newIndex >= new.size
            ) {
                return Candidate(
                    matches = emptyList(),
                    movementCost = 0,
                )
            }

            val key =
                oldIndex to newIndex

            memo[key]?.let {
                return it
            }

            /*
             * Option 1:
             * old grapheme is removed.
             */
            var best =
                solve(
                    oldIndex + 1,
                    newIndex,
                )

            /*
             * Option 2:
             * new grapheme is inserted.
             */
            best =
                better(
                    best,
                    solve(
                        oldIndex,
                        newIndex + 1,
                    ),
                )

            /*
             * Option 3:
             * reuse grapheme.
             */
            if (
                old[oldIndex].text ==
                new[newIndex].text
            ) {

                val suffix =
                    solve(
                        oldIndex + 1,
                        newIndex + 1,
                    )

                val reuse =
                    Candidate(
                        matches =
                            listOf(
                                Match(
                                    oldIndex =
                                        oldIndex,
                                    newIndex =
                                        newIndex,
                                )
                            ) + suffix.matches,

                        movementCost =
                            abs(
                                oldIndex -
                                    newIndex
                            ) +
                                suffix.movementCost,
                    )

                best =
                    better(
                        best,
                        reuse,
                    )
            }

            memo[key] = best

            return best
        }

        return solve(
            oldIndex = 0,
            newIndex = 0,
        ).matches
    }
}


/* ============================================================
 * COMPOSABLE
 * ============================================================ */

@Composable
fun MorphingText(
    text: String,
    modifier: Modifier = Modifier,
    style: TextStyle = LocalTextStyle.current,
    animationSpec: MorphingTextAnimationSpec =
        MorphingTextAnimationSpec(),
    matcher: MorphingTextMatcher =
        MinimumMovementMatcher,
) {

    val textMeasurer =
        rememberTextMeasurer(
            cacheSize = 64
        )

    /*
     * The text whose complete transition has finished.
     *
     * Incoming `text` NEVER directly changes what is rendered.
     */
    var committedText by remember {
        mutableStateOf(text)
    }

    /*
     * Current transition.
     *
     * null means stable/idle.
     */
    var activePlan by remember {
        mutableStateOf<TransitionPlan?>(null)
    }

    /*
     * Current phase.
     *
     * null means stable/idle.
     */
    var activePhase by remember {
        mutableStateOf<MorphPhase?>(null)
    }

    /*
     * Progress belongs ONLY to the current phase.
     *
     * Every phase starts at 0 and ends at 1.
     */
    val phaseProgress =
        remember {
            Animatable(0f)
        }

    /*
     * Requests arriving while an animation is active collapse
     * to the newest request.
     */
    val requests =
        remember {
            Channel<String>(
                capacity =
                    Channel.CONFLATED
            )
        }

    /*
     * Updated configuration can be read by the long-lived
     * worker without cancelling it.
     *
     * Configuration is captured at the START of a transition.
     */
    val latestSpec by
        rememberUpdatedState(
            animationSpec
        )

    val latestMatcher by
        rememberUpdatedState(
            matcher
        )


    /* ========================================================
     * REQUEST PRODUCER
     * ======================================================== */

    LaunchedEffect(text) {

        if (
            text != committedText
        ) {
            requests.trySend(text)
        }
    }


    /* ========================================================
     * SINGLE LONG-LIVED TRANSITION WORKER
     *
     * Never key this effect on:
     *
     * text
     * committedText
     * activePlan
     * activePhase
     *
     * Otherwise changing those values could cancel animateTo().
     * ======================================================== */

    LaunchedEffect(Unit) {

        for (
            requestedDestination
            in requests
        ) {

            /*
             * Ignore stale request.
             */
            if (
                requestedDestination ==
                committedText
            ) {
                continue
            }

            /*
             * Freeze the source/destination/configuration for
             * this entire transition.
             */
            val source =
                committedText

            val destination =
                requestedDestination

            val spec =
                latestSpec

            val transitionMatcher =
                latestMatcher

            val plan =
                createTransitionPlan(
                    oldText =
                        source,
                    newText =
                        destination,
                    matcher =
                        transitionMatcher,
                )

            /*
             * Animation now owns all rendering.
             */
            activePlan =
                plan


            /* =================================================
             * PHASE 1 — REMOVE
             * ================================================= */

            activePhase =
                MorphPhase.Remove

            animatePhase(
                progress =
                    phaseProgress,
                durationMillis =
                    spec.exitDurationMillis,
            )


            /* =================================================
             * PHASE 2 — MOVE
             * ================================================= */

            activePhase =
                MorphPhase.Move

            animatePhase(
                progress =
                    phaseProgress,
                durationMillis =
                    spec.moveDurationMillis,
            )


            /* =================================================
             * PHASE 3 — INSERT
             *
             * enterDurationMillis is used DIRECTLY here.
             *
             * If this is 1000, this phase takes 1000ms.
             * ================================================= */

            activePhase =
                MorphPhase.Insert

            animatePhase(
                progress =
                    phaseProgress,
                durationMillis =
                    spec.enterDurationMillis,
            )


            /* =================================================
             * COMMIT
             *
             * Only after ALL THREE phases finish.
             * ================================================= */

            committedText =
                destination

            activePhase =
                null

            activePlan =
                null

            /*
             * At this point the Canvas switches from transition
             * rendering to drawing the complete committed word.
             *
             * If requests arrived during this transition, the
             * conflated Channel contains only the latest one.
             */
        }
    }


    /* ========================================================
     * VISUAL TEXT
     *
     * Notice that public `text` is NOT used.
     * ======================================================== */

    val plan =
        activePlan

    val visualOldText =
        plan?.oldText
            ?: committedText

    val visualNewText =
        plan?.newText
            ?: committedText


    /* ========================================================
     * SEGMENT
     * ======================================================== */

    val oldGraphemes =
        remember(
            visualOldText
        ) {
            segmentGraphemes(
                visualOldText
            )
        }

    val newGraphemes =
        remember(
            visualNewText
        ) {
            segmentGraphemes(
                visualNewText
            )
        }


    /* ========================================================
     * MEASURE
     * ======================================================== */

    val oldWord =
        remember(
            visualOldText,
            style,
            textMeasurer,
        ) {
            measureWord(
                text =
                    visualOldText,
                graphemes =
                    oldGraphemes,
                textMeasurer =
                    textMeasurer,
                style =
                    style,
            )
        }

    val newWord =
        remember(
            visualNewText,
            style,
            textMeasurer,
        ) {
            measureWord(
                text =
                    visualNewText,
                graphemes =
                    newGraphemes,
                textMeasurer =
                    textMeasurer,
                style =
                    style,
            )
        }


    /* ========================================================
     * SIZE
     * ======================================================== */

    val widthPx =
        max(
            oldWord.width,
            newWord.width,
        )

    val heightPx =
        max(
            oldWord.height,
            newWord.height,
        )

    val density =
        LocalDensity.current

    val widthDp =
        with(density) {
            widthPx.toDp()
        }

    val heightDp =
        with(density) {
            heightPx.toDp()
        }


    /* ========================================================
     * RENDER
     * ======================================================== */

    Canvas(
        modifier =
            modifier
                .requiredSize(
                    width =
                        widthDp,
                    height =
                        heightDp,
                )
                .semantics {

                    /*
                     * Semantic value changes only after the
                     * visual transition has finished.
                     */
                    this.text =
                        AnnotatedString(
                            committedText
                        )
                }
    ) {

        val currentPlan =
            activePlan

        val currentPhase =
            activePhase

        if (
            currentPlan == null ||
            currentPhase == null
        ) {

            /*
             * IDLE
             *
             * Exactly one complete committed word.
             */
            drawStableWord(
                word =
                    oldWord
            )

            return@Canvas
        }


        /*
         * Convert:
         *
         * phase + phaseProgress
         *
         * into the three renderer values.
         *
         * No easing.
         * Completely linear.
         */
        val frame =
            calculateFrameProgress(
                phase =
                    currentPhase,
                progress =
                    phaseProgress.value,
            )

        /*
         * During animation this is the ONLY text renderer.
         */
        drawTransition(
            plan =
                currentPlan,
            oldWord =
                oldWord,
            newWord =
                newWord,
            frame =
                frame,
        )
    }
}


/* ============================================================
 * PHASE ANIMATION
 * ============================================================ */

private suspend fun animatePhase(
    progress: Animatable<Float, *>,
    durationMillis: Int,
) {

    /*
     * Every phase starts from exactly zero.
     */
    progress.snapTo(0f)

    if (
        durationMillis == 0
    ) {

        /*
         * Zero duration immediately resolves the phase.
         */
        progress.snapTo(1f)

        return
    }

    progress.animateTo(
        targetValue =
            1f,

        animationSpec =
            tween(
                durationMillis =
                    durationMillis,

                /*
                 * Explicitly linear.
                 */
                easing =
                    LinearEasing,
            ),
    )
}


/* ============================================================
 * MODEL
 * ============================================================ */

@Immutable
data class Grapheme(
    val text: String,
    val startOffset: Int,
    val endOffset: Int,
)


@Immutable
data class Match(
    val oldIndex: Int,
    val newIndex: Int,
)


@Immutable
data class TransitionPlan(
    val oldText: String,
    val newText: String,
    val old: List<Grapheme>,
    val new: List<Grapheme>,
    val matches: List<Match>,
    val removedOldIndices: Set<Int>,
    val insertedNewIndices: Set<Int>,
)


/* ============================================================
 * GRAPHEME SEGMENTATION
 * ============================================================ */

internal fun segmentGraphemes(
    text: String,
    locale: Locale =
        Locale.getDefault(),
): List<Grapheme> {

    if (
        text.isEmpty()
    ) {
        return emptyList()
    }

    val iterator =
        BreakIterator
            .getCharacterInstance(
                locale
            )

    iterator.setText(
        text
    )

    val result =
        ArrayList<Grapheme>()

    var start =
        iterator.first()

    var end =
        iterator.next()

    while (
        end != BreakIterator.DONE
    ) {

        result +=
            Grapheme(
                text =
                    text.substring(
                        start,
                        end,
                    ),
                startOffset =
                    start,
                endOffset =
                    end,
            )

        start =
            end

        end =
            iterator.next()
    }

    return result
}


/* ============================================================
 * TRANSITION PLAN
 * ============================================================ */

internal fun createTransitionPlan(
    oldText: String,
    newText: String,
    matcher: MorphingTextMatcher =
        MinimumMovementMatcher,
): TransitionPlan {

    val old =
        segmentGraphemes(
            oldText
        )

    val new =
        segmentGraphemes(
            newText
        )

    val matches =
        matcher.match(
            old =
                old,
            new =
                new,
        )

    validateMatches(
        old =
            old,
        new =
            new,
        matches =
            matches,
    )

    val matchedOld =
        matches
            .mapTo(
                HashSet()
            ) {
                it.oldIndex
            }

    val matchedNew =
        matches
            .mapTo(
                HashSet()
            ) {
                it.newIndex
            }

    val removed =
        old.indices
            .filterTo(
                LinkedHashSet()
            ) {
                it !in matchedOld
            }

    val inserted =
        new.indices
            .filterTo(
                LinkedHashSet()
            ) {
                it !in matchedNew
            }

    return TransitionPlan(
        oldText =
            oldText,
        newText =
            newText,
        old =
            old,
        new =
            new,
        matches =
            matches,
        removedOldIndices =
            removed,
        insertedNewIndices =
            inserted,
    )
}


private fun validateMatches(
    old: List<Grapheme>,
    new: List<Grapheme>,
    matches: List<Match>,
) {

    var previousOld =
        -1

    var previousNew =
        -1

    val seenOld =
        HashSet<Int>()

    val seenNew =
        HashSet<Int>()

    for (
        match in matches
    ) {

        require(
            match.oldIndex in
                old.indices
        ) {
            "Invalid oldIndex=${match.oldIndex}"
        }

        require(
            match.newIndex in
                new.indices
        ) {
            "Invalid newIndex=${match.newIndex}"
        }

        require(
            seenOld.add(
                match.oldIndex
            )
        ) {
            "oldIndex=${match.oldIndex} matched twice"
        }

        require(
            seenNew.add(
                match.newIndex
            )
        ) {
            "newIndex=${match.newIndex} matched twice"
        }

        require(
            old[
                match.oldIndex
            ].text ==
                new[
                    match.newIndex
                ].text
        ) {
            "Matcher matched different graphemes"
        }

        require(
            match.oldIndex >
                previousOld &&
                match.newIndex >
                previousNew
        ) {
            "Matcher must preserve relative order"
        }

        previousOld =
            match.oldIndex

        previousNew =
            match.newIndex
    }
}


/* ============================================================
 * PURE FRAME CALCULATION
 * ============================================================ */

@Immutable
internal data class FrameProgress(
    val exit: Float,
    val move: Float,
    val enter: Float,
)


/**
 * Pure deterministic function.
 *
 * This is deliberately independent of Compose animation APIs.
 */
internal fun calculateFrameProgress(
    phase: MorphPhase,
    progress: Float,
): FrameProgress {

    val p =
        progress.coerceIn(
            0f,
            1f,
        )

    return when (
        phase
    ) {

        MorphPhase.Remove ->
            FrameProgress(
                exit =
                    p,
                move =
                    0f,
                enter =
                    0f,
            )

        MorphPhase.Move ->
            FrameProgress(
                exit =
                    1f,
                move =
                    p,
                enter =
                    0f,
            )

        MorphPhase.Insert ->
            FrameProgress(
                exit =
                    1f,
                move =
                    1f,
                enter =
                    p,
            )
    }
}


/* ============================================================
 * MEASUREMENT
 * ============================================================ */

@Immutable
internal data class MeasuredGrapheme(
    val grapheme: Grapheme,
    val x: Float,
    val isolatedLayout: TextLayoutResult,
)


@Immutable
internal data class MeasuredWord(
    val fullLayout: TextLayoutResult?,
    val graphemes: List<MeasuredGrapheme>,
    val width: Float,
    val height: Float,
)


private fun measureWord(
    text: String,
    graphemes: List<Grapheme>,
    textMeasurer: TextMeasurer,
    style: TextStyle,
): MeasuredWord {

    if (
        text.isEmpty()
    ) {

        /*
         * Height probe keeps the component's line height stable
         * when transitioning from/to an empty string.
         */
        val probe =
            textMeasurer.measure(
                text =
                    AnnotatedString(
                        "Mg"
                    ),
                style =
                    style,
                softWrap =
                    false,
                maxLines =
                    1,
                constraints =
                    Constraints(),
            )

        return MeasuredWord(
            fullLayout =
                null,
            graphemes =
                emptyList(),
            width =
                0f,
            height =
                probe
                    .size
                    .height
                    .toFloat(),
        )
    }

    /*
     * Measure complete word first.
     *
     * This determines the actual destination/source positions.
     */
    val full =
        textMeasurer.measure(
            text =
                AnnotatedString(
                    text
                ),
            style =
                style,
            softWrap =
                false,
            maxLines =
                1,
            constraints =
                Constraints(),
        )

    val measured =
        graphemes.map {
                grapheme ->

            /*
             * LTR/simple-script contract:
             * obtain the grapheme's X from the complete layout.
             */
            val box =
                full.getBoundingBox(
                    grapheme.startOffset
                )

            /*
             * Independently drawable glyph/grapheme.
             *
             * Measurement happens outside DrawScope.
             */
            val isolated =
                textMeasurer.measure(
                    text =
                        AnnotatedString(
                            grapheme.text
                        ),
                    style =
                        style,
                    softWrap =
                        false,
                    maxLines =
                        1,
                    constraints =
                        Constraints(),
                )

            MeasuredGrapheme(
                grapheme =
                    grapheme,
                x =
                    box.left,
                isolatedLayout =
                    isolated,
            )
        }

    return MeasuredWord(
        fullLayout =
            full,
        graphemes =
            measured,
        width =
            full
                .size
                .width
                .toFloat(),
        height =
            full
                .size
                .height
                .toFloat(),
    )
}


/* ============================================================
 * RENDERING
 * ============================================================ */

private fun DrawScope.drawStableWord(
    word: MeasuredWord,
) {

    val layout =
        word.fullLayout
            ?: return

    /*
     * Stable state uses Compose's complete shaped layout.
     */
    drawText(
        textLayoutResult =
            layout,
        topLeft =
            Offset.Zero,
    )
}


private fun DrawScope.drawTransition(
    plan: TransitionPlan,
    oldWord: MeasuredWord,
    newWord: MeasuredWord,
    frame: FrameProgress,
) {

    val matchByOldIndex =
        plan.matches
            .associateBy {
                it.oldIndex
            }

    val matchedNewIndices =
        plan.matches
            .mapTo(
                HashSet()
            ) {
                it.newIndex
            }


    /* --------------------------------------------------------
     * OLD OBJECTS
     *
     * Each old grapheme is rendered exactly once.
     * -------------------------------------------------------- */

    oldWord.graphemes
        .forEachIndexed {
                oldIndex,
                oldGrapheme ->

            val match =
                matchByOldIndex[
                    oldIndex
                ]

            if (
                match == null
            ) {

                /*
                 * REMOVED CHARACTER
                 *
                 * Always stays at old X.
                 *
                 * During REMOVE:
                 * alpha 1 -> 0.
                 *
                 * During MOVE/INSERT:
                 * remains invisible.
                 */
                drawGrapheme(
                    grapheme =
                        oldGrapheme,
                    x =
                        oldGrapheme.x,
                    alpha =
                        1f -
                            frame.exit,
                )

            } else {

                /*
                 * SURVIVING CHARACTER
                 *
                 * It is the SAME rendered object throughout
                 * the transition.
                 */
                val destination =
                    newWord.graphemes[
                        match.newIndex
                    ]

                val x =
                    lerp(
                        start =
                            oldGrapheme.x,
                        end =
                            destination.x,
                        fraction =
                            frame.move,
                    )

                drawGrapheme(
                    grapheme =
                        oldGrapheme,
                    x =
                        x,
                    alpha =
                        1f,
                )
            }
        }


    /* --------------------------------------------------------
     * NEW-ONLY OBJECTS
     *
     * Matched new graphemes are deliberately skipped.
     *
     * Therefore a survivor can NEVER be drawn twice.
     * -------------------------------------------------------- */

    newWord.graphemes
        .forEachIndexed {
                newIndex,
                newGrapheme ->

            if (
                newIndex in
                matchedNewIndices
            ) {
                return@forEachIndexed
            }

            /*
             * INSERTED CHARACTER
             *
             * Always at final X.
             *
             * REMOVE:
             * alpha = 0
             *
             * MOVE:
             * alpha = 0
             *
             * INSERT:
             * alpha 0 -> 1
             */
            drawGrapheme(
                grapheme =
                    newGrapheme,
                x =
                    newGrapheme.x,
                alpha =
                    frame.enter,
            )
        }
}


private fun DrawScope.drawGrapheme(
    grapheme: MeasuredGrapheme,
    x: Float,
    alpha: Float,
) {

    if (
        alpha <= 0f
    ) {
        return
    }

    drawText(
        textLayoutResult =
            grapheme.isolatedLayout,
        topLeft =
            Offset(
                x =
                    x,
                y =
                    0f,
            ),
        alpha =
            alpha.coerceIn(
                0f,
                1f,
            ),
    )
}


private fun lerp(
    start: Float,
    end: Float,
    fraction: Float,
): Float {

    val p =
        fraction.coerceIn(
            0f,
            1f,
        )

    return start +
        (
            end - start
        ) * p
}
