/* ============================================================
 * PUBLIC API
 * ============================================================ */

@Immutable
data class MorphingTextAnimationSpec(
    val exitDurationMillis: Int = 150,
    val moveDurationMillis: Int = 250,
    val enterDurationMillis: Int = 150,
    val moveEasing: Easing = FastOutSlowInEasing,
    val fadeEasing: Easing = LinearEasing,
) {
    init {
        require(exitDurationMillis >= 0)
        require(moveDurationMillis >= 0)
        require(enterDurationMillis >= 0)
    }

    val totalDurationMillis: Int
        get() =
            exitDurationMillis +
                moveDurationMillis +
                enterDurationMillis
}


fun interface MorphingTextMatcher {
    fun match(
        old: List<Grapheme>,
        new: List<Grapheme>,
    ): List<Match>
}


/**
 * Deterministic matcher.
 *
 * Priority:
 * 1. Maximize number of reused graphemes.
 * 2. Minimize total index movement.
 * 3. Preserve relative order.
 * 4. On an otherwise exact tie, prefer the lexicographically
 *    smaller sequence of (oldIndex, newIndex) pairs.
 */
object MinimumMovementMatcher : MorphingTextMatcher {

    private data class Candidate(
        val matches: List<Match>,
        val movementCost: Int,
    )

    override fun match(
        old: List<Grapheme>,
        new: List<Grapheme>,
    ): List<Match> {

        if (old.isEmpty() || new.isEmpty()) {
            return emptyList()
        }

        val memo =
            HashMap<Pair<Int, Int>, Candidate>()

        fun better(
            a: Candidate,
            b: Candidate,
        ): Candidate {

            if (a.matches.size != b.matches.size) {
                return if (a.matches.size > b.matches.size) a else b
            }

            if (a.movementCost != b.movementCost) {
                return if (a.movementCost < b.movementCost) a else b
            }

            return if (
                compareMatchLists(
                    a.matches,
                    b.matches,
                ) <= 0
            ) {
                a
            } else {
                b
            }
        }

        fun solve(
            oldIndex: Int,
            newIndex: Int,
        ): Candidate {

            if (
                oldIndex >= old.size ||
                newIndex >= new.size
            ) {
                return Candidate(
                    matches = emptyList(),
                    movementCost = 0,
                )
            }

            val key =
                oldIndex to newIndex

            memo[key]?.let {
                return it
            }

            var best =
                solve(
                    oldIndex + 1,
                    newIndex,
                )

            best =
                better(
                    best,
                    solve(
                        oldIndex,
                        newIndex + 1,
                    ),
                )

            if (
                old[oldIndex].text ==
                new[newIndex].text
            ) {

                val suffix =
                    solve(
                        oldIndex + 1,
                        newIndex + 1,
                    )

                val matchCandidate =
                    Candidate(
                        matches =
                            buildList(
                                suffix.matches.size + 1
                            ) {
                                add(
                                    Match(
                                        oldIndex = oldIndex,
                                        newIndex = newIndex,
                                    )
                                )
                                addAll(suffix.matches)
                            },

                        movementCost =
                            abs(oldIndex - newIndex) +
                                suffix.movementCost,
                    )

                best =
                    better(
                        best,
                        matchCandidate,
                    )
            }

            memo[key] = best

            return best
        }

        return solve(0, 0).matches
    }


    private fun compareMatchLists(
        first: List<Match>,
        second: List<Match>,
    ): Int {

        val size =
            minOf(
                first.size,
                second.size,
            )

        for (index in 0 until size) {

            val a =
                first[index]

            val b =
                second[index]

            if (a.oldIndex != b.oldIndex) {
                return a.oldIndex.compareTo(
                    b.oldIndex
                )
            }

            if (a.newIndex != b.newIndex) {
                return a.newIndex.compareTo(
                    b.newIndex
                )
            }
        }

        return first.size.compareTo(
            second.size
        )
    }
}


/**
 * Short, single-line animated text.
 *
 * Transition:
 *
 * REMOVE -> MOVE -> INSERT
 *
 * Rapid-update policy:
 *
 * Finish the active transition, then animate directly to the
 * latest requested text. Superseded pending values are skipped.
 */
@Composable
fun MorphingText(
    text: String,
    modifier: Modifier = Modifier,
    style: TextStyle = LocalTextStyle.current,
    animationSpec: MorphingTextAnimationSpec =
        MorphingTextAnimationSpec(),
    matcher: MorphingTextMatcher =
        MinimumMovementMatcher,
) {

    val textMeasurer =
        rememberTextMeasurer(
            cacheSize = 64
        )

    /*
     * Text whose stable visual state has actually been reached.
     */
    var committedText by remember {
        mutableStateOf(text)
    }

    /*
     * Latest caller request.
     */
    val latestText by
        rememberUpdatedState(text)

    val latestSpec by
        rememberUpdatedState(animationSpec)

    val latestMatcher by
        rememberUpdatedState(matcher)

    /*
     * Transition currently being rendered.
     */
    var activePlan by remember {
        mutableStateOf<TransitionPlan?>(null)
    }

    /*
     * Destination of the currently active transition.
     */
    var activeDestination by remember {
        mutableStateOf<String?>(null)
    }

    /*
     * Used only to wake the transition worker.
     */
    var generation by remember {
        mutableLongStateOf(0L)
    }

    val progress =
        remember {
            Animatable(1f)
        }

    /*
     * Record every incoming request.
     *
     * We don't animate here. This effect can safely be cancelled
     * and restarted because it only increments the generation.
     */
    LaunchedEffect(text) {
        generation++
    }

    /*
     * A transition is keyed by activeDestination rather than by
     * text itself. Once started, a text update does not cancel
     * the active animation.
     */
    if (activeDestination == null &&
        committedText != text
    ) {
        activeDestination = text
    }

    val destination =
        activeDestination

    LaunchedEffect(destination) {

        if (destination == null) {
            return@LaunchedEffect
        }

        val source =
            committedText

        val spec =
            latestSpec

        val plan =
            createTransitionPlan(
                oldText = source,
                newText = destination,
                matcher = latestMatcher,
            )

        activePlan = plan

        if (spec.totalDurationMillis == 0) {

            progress.snapTo(1f)

        } else {

            progress.snapTo(0f)

            progress.animateTo(
                targetValue = 1f,
                animationSpec =
                    tween(
                        durationMillis =
                            spec.totalDurationMillis,
                        easing = LinearEasing,
                    ),
            )
        }

        committedText =
            destination

        activePlan =
            null

        activeDestination =
            null
    }

    /*
     * Once an animation finishes, composition runs again.
     *
     * If latest text changed while it was running,
     * activeDestination becomes that latest value.
     *
     * This implements:
     *
     * current -> active destination -> latest
     *
     * rather than queueing every intermediate request.
     */
    @Suppress("UNUSED_VARIABLE")
    val generationRead =
        generation

    val plan =
        activePlan

    val oldText =
        plan?.oldText
            ?: committedText

    val newText =
        plan?.newText
            ?: committedText

    val oldGraphemes =
        remember(oldText) {
            segmentGraphemes(oldText)
        }

    val newGraphemes =
        remember(newText) {
            segmentGraphemes(newText)
        }

    /*
     * Measure outside DrawScope.
     */
    val oldWord =
        remember(
            oldText,
            style,
            textMeasurer,
        ) {
            measureWord(
                text = oldText,
                graphemes = oldGraphemes,
                textMeasurer = textMeasurer,
                style = style,
            )
        }

    val newWord =
        remember(
            newText,
            style,
            textMeasurer,
        ) {
            measureWord(
                text = newText,
                graphemes = newGraphemes,
                textMeasurer = textMeasurer,
                style = style,
            )
        }

    val widthPx =
        max(
            oldWord.width,
            newWord.width,
        )

    val heightPx =
        max(
            oldWord.height,
            newWord.height,
        )

    val density =
        LocalDensity.current

    val widthDp =
        with(density) {
            widthPx.toDp()
        }

    val heightDp =
        with(density) {
            heightPx.toDp()
        }

    Canvas(
        modifier =
            modifier
                .requiredSize(
                    width = widthDp,
                    height = heightDp,
                )
                .semantics {
                    /*
                     * Logical content is always the latest target,
                     * not an intermediate visual frame.
                     */
                    this.text =
                        AnnotatedString(text)
                }
    ) {

        if (plan == null) {

            drawStableWord(newWord)

            return@Canvas
        }

        val phase =
            calculatePhaseProgress(
                progress =
                    progress.value,
                spec =
                    latestSpec,
            )

        drawTransition(
            plan = plan,
            oldWord = oldWord,
            newWord = newWord,
            phase = phase,
            spec = latestSpec,
        )
    }
}


/* ============================================================
 * DATA MODEL
 * ============================================================ */

@Immutable
data class Grapheme(
    val text: String,
    val startOffset: Int,
    val endOffset: Int,
)


@Immutable
data class Match(
    val oldIndex: Int,
    val newIndex: Int,
)


@Immutable
data class TransitionPlan(
    val oldText: String,
    val newText: String,
    val old: List<Grapheme>,
    val new: List<Grapheme>,
    val matches: List<Match>,
    val removedOldIndices: Set<Int>,
    val insertedNewIndices: Set<Int>,
)


/* ============================================================
 * GRAPHEME SEGMENTATION
 * ============================================================ */

internal fun segmentGraphemes(
    text: String,
    locale: Locale = Locale.getDefault(),
): List<Grapheme> {

    if (text.isEmpty()) {
        return emptyList()
    }

    val iterator =
        BreakIterator.getCharacterInstance(
            locale
        )

    iterator.setText(text)

    val result =
        ArrayList<Grapheme>()

    var start =
        iterator.first()

    var end =
        iterator.next()

    while (
        end != BreakIterator.DONE
    ) {

        result +=
            Grapheme(
                text =
                    text.substring(
                        start,
                        end,
                    ),
                startOffset =
                    start,
                endOffset =
                    end,
            )

        start =
            end

        end =
            iterator.next()
    }

    return result
}


/* ============================================================
 * TRANSITION PLANNER
 * ============================================================ */

internal fun createTransitionPlan(
    oldText: String,
    newText: String,
    matcher: MorphingTextMatcher =
        MinimumMovementMatcher,
): TransitionPlan {

    val old =
        segmentGraphemes(oldText)

    val new =
        segmentGraphemes(newText)

    val matches =
        matcher.match(
            old = old,
            new = new,
        )

    validateMatches(
        old = old,
        new = new,
        matches = matches,
    )

    val matchedOld =
        matches
            .mapTo(HashSet()) {
                it.oldIndex
            }

    val matchedNew =
        matches
            .mapTo(HashSet()) {
                it.newIndex
            }

    val removed =
        old.indices
            .filterTo(
                LinkedHashSet()
            ) {
                it !in matchedOld
            }

    val inserted =
        new.indices
            .filterTo(
                LinkedHashSet()
            ) {
                it !in matchedNew
            }

    return TransitionPlan(
        oldText = oldText,
        newText = newText,
        old = old,
        new = new,
        matches = matches,
        removedOldIndices = removed,
        insertedNewIndices = inserted,
    )
}


private fun validateMatches(
    old: List<Grapheme>,
    new: List<Grapheme>,
    matches: List<Match>,
) {

    var previousOld =
        -1

    var previousNew =
        -1

    val seenOld =
        HashSet<Int>()

    val seenNew =
        HashSet<Int>()

    for (match in matches) {

        require(
            match.oldIndex in old.indices
        ) {
            "Matcher returned invalid oldIndex=${match.oldIndex}"
        }

        require(
            match.newIndex in new.indices
        ) {
            "Matcher returned invalid newIndex=${match.newIndex}"
        }

        require(
            seenOld.add(match.oldIndex)
        ) {
            "Matcher reused oldIndex=${match.oldIndex}"
        }

        require(
            seenNew.add(match.newIndex)
        ) {
            "Matcher reused newIndex=${match.newIndex}"
        }

        require(
            old[match.oldIndex].text ==
                new[match.newIndex].text
        ) {
            "Matcher matched different graphemes: " +
                "${old[match.oldIndex].text} != " +
                new[match.newIndex].text
        }

        require(
            match.oldIndex > previousOld &&
                match.newIndex > previousNew
        ) {
            "Matcher must preserve relative order"
        }

        previousOld =
            match.oldIndex

        previousNew =
            match.newIndex
    }
}


/* ============================================================
 * DETERMINISTIC TIMELINE
 * ============================================================ */

@Immutable
internal data class PhaseProgress(
    val exit: Float,
    val move: Float,
    val enter: Float,
)


internal fun calculatePhaseProgress(
    progress: Float,
    spec: MorphingTextAnimationSpec,
): PhaseProgress {

    val p =
        progress.coerceIn(
            0f,
            1f,
        )

    val total =
        spec.totalDurationMillis

    if (total == 0) {
        return PhaseProgress(
            exit = 1f,
            move = 1f,
            enter = 1f,
        )
    }

    val time =
        p * total.toFloat()

    val moveStart =
        spec.exitDurationMillis.toFloat()

    val enterStart =
        (
            spec.exitDurationMillis +
                spec.moveDurationMillis
        ).toFloat()

    return PhaseProgress(
        exit =
            phaseFraction(
                time = time,
                start = 0f,
                durationMillis =
                    spec.exitDurationMillis,
            ),

        move =
            phaseFraction(
                time = time,
                start = moveStart,
                durationMillis =
                    spec.moveDurationMillis,
            ),

        enter =
            phaseFraction(
                time = time,
                start = enterStart,
                durationMillis =
                    spec.enterDurationMillis,
            ),
    )
}


private fun phaseFraction(
    time: Float,
    start: Float,
    durationMillis: Int,
): Float {

    if (durationMillis == 0) {
        return if (time >= start) {
            1f
        } else {
            0f
        }
    }

    return (
        (time - start) /
            durationMillis.toFloat()
    ).coerceIn(
        0f,
        1f,
    )
}


/* ============================================================
 * MEASUREMENT
 * ============================================================ */

@Immutable
internal data class MeasuredGrapheme(
    val grapheme: Grapheme,

    /*
     * Position derived from the complete shaped word.
     */
    val x: Float,

    /*
     * Independently drawable version used while animating.
     */
    val isolatedLayout: TextLayoutResult,
)


@Immutable
internal data class MeasuredWord(
    val text: String,
    val fullLayout: TextLayoutResult?,
    val graphemes: List<MeasuredGrapheme>,
    val width: Float,
    val height: Float,
)


private fun measureWord(
    text: String,
    graphemes: List<Grapheme>,
    textMeasurer: TextMeasurer,
    style: TextStyle,
): MeasuredWord {

    /*
     * Preserve line height for empty strings.
     */
    if (text.isEmpty()) {

        val heightProbe =
            textMeasurer.measure(
                text =
                    AnnotatedString("Mg"),
                style =
                    style,
                softWrap =
                    false,
                maxLines =
                    1,
                constraints =
                    Constraints(),
            )

        return MeasuredWord(
            text = text,
            fullLayout = null,
            graphemes = emptyList(),
            width = 0f,
            height =
                heightProbe.size.height.toFloat(),
        )
    }

    /*
     * Complete word layout gives us final visual positions.
     */
    val fullLayout =
        textMeasurer.measure(
            text =
                AnnotatedString(text),
            style =
                style,
            softWrap =
                false,
            maxLines =
                1,
            constraints =
                Constraints(),
        )

    val measured =
        graphemes.map { grapheme ->

            /*
             * The first code-point box gives the leading visual
             * position of this grapheme in this deliberately
             * single-line LTR-oriented component.
             */
            val boundingBox =
                fullLayout.getBoundingBox(
                    grapheme.startOffset
                )

            /*
             * Premeasure once.
             *
             * Never measure inside DrawScope.
             */
            val isolated =
                textMeasurer.measure(
                    text =
                        AnnotatedString(
                            grapheme.text
                        ),
                    style =
                        style,
                    softWrap =
                        false,
                    maxLines =
                        1,
                    constraints =
                        Constraints(),
                )

            MeasuredGrapheme(
                grapheme =
                    grapheme,
                x =
                    boundingBox.left,
                isolatedLayout =
                    isolated,
            )
        }

    return MeasuredWord(
        text =
            text,
        fullLayout =
            fullLayout,
        graphemes =
            measured,
        width =
            fullLayout.size.width.toFloat(),
        height =
            fullLayout.size.height.toFloat(),
    )
}


/* ============================================================
 * DRAWING
 * ============================================================ */

private fun DrawScope.drawStableWord(
    word: MeasuredWord,
) {

    val layout =
        word.fullLayout
            ?: return

    /*
     * When idle, use Compose's complete shaped layout.
     */
    drawText(
        textLayoutResult =
            layout,
        topLeft =
            Offset.Zero,
    )
}


private fun DrawScope.drawTransition(
    plan: TransitionPlan,
    oldWord: MeasuredWord,
    newWord: MeasuredWord,
    phase: PhaseProgress,
    spec: MorphingTextAnimationSpec,
) {

    val exit =
        spec.fadeEasing
            .transform(phase.exit)
            .coerceIn(0f, 1f)

    val move =
        spec.moveEasing
            .transform(phase.move)
            .coerceIn(0f, 1f)

    val enter =
        spec.fadeEasing
            .transform(phase.enter)
            .coerceIn(0f, 1f)

    val byOldIndex =
        plan.matches
            .associateBy {
                it.oldIndex
            }

    val matchedNew =
        plan.matches
            .mapTo(HashSet()) {
                it.newIndex
            }

    /*
     * OLD OBJECTS
     *
     * Removed objects:
     *   fixed X + fading alpha
     *
     * Surviving objects:
     *   alpha = 1 + interpolated X
     */
    oldWord.graphemes
        .forEachIndexed {
                oldIndex,
                grapheme ->

            val match =
                byOldIndex[oldIndex]

            if (match == null) {

                drawAnimatedGrapheme(
                    grapheme =
                        grapheme,
                    x =
                        grapheme.x,
                    alpha =
                        1f - exit,
                )

            } else {

                val destination =
                    newWord.graphemes[
                        match.newIndex
                    ]

                val x =
                    lerp(
                        start =
                            grapheme.x,
                        end =
                            destination.x,
                        fraction =
                            move,
                    )

                drawAnimatedGrapheme(
                    grapheme =
                        grapheme,
                    x =
                        x,
                    alpha =
                        1f,
                )
            }
        }

    /*
     * NEW OBJECTS
     *
     * Only unmatched destination graphemes are rendered here.
     * They stay at final X and fade in.
     */
    newWord.graphemes
        .forEachIndexed {
                newIndex,
                grapheme ->

            if (
                newIndex !in matchedNew
            ) {

                drawAnimatedGrapheme(
                    grapheme =
                        grapheme,
                    x =
                        grapheme.x,
                    alpha =
                        enter,
                )
            }
        }
}


private fun DrawScope.drawAnimatedGrapheme(
    grapheme: MeasuredGrapheme,
    x: Float,
    alpha: Float,
) {

    drawText(
        textLayoutResult =
            grapheme.isolatedLayout,
        topLeft =
            Offset(
                x = x,
                y = 0f,
            ),
        alpha =
            alpha.coerceIn(
                0f,
                1f,
            ),
    )
}


private fun lerp(
    start: Float,
    end: Float,
    fraction: Float,
): Float {

    val f =
        fraction.coerceIn(
            0f,
            1f,
        )

    return start +
        ((end - start) * f)
}
