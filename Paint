@Composable
fun ConcurrentStrokeCanvas(
    state: StrokeCanvasState,
    modifier: Modifier = Modifier
) {
    var canvasSize by remember { mutableStateOf(IntSize.Zero) }

    @Suppress("UNUSED_VARIABLE")
    val version = state.versionForCompose

    SideEffect {
        if (canvasSize.width > 0 && canvasSize.height > 0) {
            state.scheduleVisibleTiles(canvasSize.width, canvasSize.height)
        }
    }

    Canvas(
        modifier = modifier.onSizeChanged { canvasSize = it }
    ) {
        val width = size.width.roundToInt()
        val height = size.height.roundToInt()

        if (width > 0 && height > 0) {
            drawIntoCanvas { canvas ->
                state.drawCommittedTo(
                    canvas = canvas.nativeCanvas,
                    width = width,
                    height = height
                )
            }
        }
    }
}

@Stable
class StrokeCanvasState(
    private val rasterExecutor: Executor = Executors.newFixedThreadPool(2),
    private val maxCachedTiles: Int = 128
) {
    private val lock = Any()
    private val mainHandler = Handler(Looper.getMainLooper())
    private val mainThreadId = Looper.getMainLooper().thread.id

    private var composeVersion by mutableIntStateOf(0)

    internal val versionForCompose: Int
        get() = composeVersion

    private var sceneGeneration: Long = 0L
    private var viewportGeneration: Long = 0L
    private var cacheGeneration: Long = 0L

    private var scale: Float = 1f
    private var offsetX: Float = 0f
    private var offsetY: Float = 0f

    private var lastComposeWidth: Int = 0
    private var lastComposeHeight: Int = 0

    private var nextOrder: Int = 0
    private var nextJobId: Long = 0L

    private val knownRevisions = HashMap<String, Long>()
    private val strokes = LinkedHashMap<String, StrokeRecord>()

    private val undoStack = ArrayList<ModelSnapshot>()
    private val redoStack = ArrayList<ModelSnapshot>()

    private val pending = LinkedHashMap<TileKey, PendingTile>()
    private val committed = LinkedHashMap<TileKey, TileBitmap>()
    private val lru = LinkedHashMap<TileKey, Long>()

    private var lruClock: Long = 0L
    private var currentVisibleTiles: Set<TileKey> = emptySet()

    private val commitThreadIds = ArrayList<Long>()
    private var submittedJobCount: Long = 0L
    private val submittedTileKeys = ArrayList<TileKey>()
    private var rejectedCommitCount: Long = 0L
    private val evictedTiles = ArrayList<TileKey>()

    init {
        require(maxCachedTiles > 0) {
            "maxCachedTiles must be > 0"
        }
    }

    fun setViewport(scale: Float, offsetX: Float, offsetY: Float) {
        require(scale.isFinite() && scale > 0f) { "scale must be finite and > 0" }
        require(offsetX.isFinite()) { "offsetX must be finite" }
        require(offsetY.isFinite()) { "offsetY must be finite" }

        synchronized(lock) {
            this.scale = scale
            this.offsetX = offsetX
            this.offsetY = offsetY

            viewportGeneration++
            pending.clear()
            committed.clear()
            lru.clear()
            refreshVisibleTilesLocked()
        }

        requestRedraw()
    }

    fun beginStroke(strokeId: String, color: Int, widthPx: Float) {
        validateStrokeId(strokeId)
        validateWidth(widthPx)

        synchronized(lock) {
            if (strokes.containsKey(strokeId)) {
                throw IllegalArgumentException("duplicate active strokeId")
            }

            pushUndoLocked()
            redoStack.clear()

            val revision = nextRevisionLocked(strokeId)

            strokes[strokeId] = StrokeRecord(
                id = strokeId,
                color = color,
                widthPx = widthPx,
                points = emptyList(),
                ended = false,
                order = nextOrder++,
                revision = revision
            )

            sceneGeneration++
        }

        requestRedraw()
    }

    fun appendPoints(strokeId: String, points: List<StrokePoint>) {
        validateStrokeId(strokeId)
        validatePoints(points)

        if (points.isEmpty()) return

        val copied = points.map {
            StrokePoint(it.x, it.y, it.pressure)
        }

        synchronized(lock) {
            val old = strokes[strokeId]
                ?: throw IllegalArgumentException("missing stroke")

            if (old.ended) {
                throw IllegalArgumentException("stroke already ended")
            }

            pushUndoLocked()
            redoStack.clear()

            val dirtyPoints =
                if (old.points.isNotEmpty()) {
                    listOf(old.points.last()) + copied
                } else {
                    copied
                }

            val dirtyBounds = screenBoundsForPointsLocked(
                points = dirtyPoints,
                widthPx = old.widthPx
            )

            val updated = old.copy(
                points = old.points + copied,
                revision = nextRevisionLocked(strokeId)
            )

            strokes[strokeId] = updated
            sceneGeneration++

            invalidateTilesForBoundsLocked(dirtyBounds)
        }

        requestRedraw()
    }

    fun endStroke(strokeId: String) {
        validateStrokeId(strokeId)

        synchronized(lock) {
            val old = strokes[strokeId]
                ?: throw IllegalArgumentException("missing stroke")

            if (old.ended) return

            pushUndoLocked()
            redoStack.clear()

            val dirtyBounds = screenBoundsForStrokeLocked(old)

            strokes[strokeId] = old.copy(
                ended = true,
                revision = nextRevisionLocked(strokeId)
            )

            sceneGeneration++
            invalidateTilesForBoundsLocked(dirtyBounds)
        }

        requestRedraw()
    }

    fun removeStroke(strokeId: String) {
        validateStrokeId(strokeId)

        synchronized(lock) {
            val old = strokes[strokeId] ?: return

            pushUndoLocked()
            redoStack.clear()

            val dirtyBounds = screenBoundsForStrokeLocked(old)

            strokes.remove(strokeId)
            nextRevisionLocked(strokeId)

            sceneGeneration++
            invalidateTilesForBoundsLocked(dirtyBounds)
        }

        requestRedraw()
    }

    fun restyleStroke(strokeId: String, color: Int, widthPx: Float) {
        validateStrokeId(strokeId)
        validateWidth(widthPx)

        synchronized(lock) {
            val old = strokes[strokeId] ?: return

            pushUndoLocked()
            redoStack.clear()

            val oldBounds = screenBoundsForStrokeLocked(old)

            val updated = old.copy(
                color = color,
                widthPx = widthPx,
                revision = nextRevisionLocked(strokeId)
            )

            val newBounds = screenBoundsForStrokeLocked(updated)

            strokes[strokeId] = updated

            sceneGeneration++
            invalidateTilesForBoundsLocked(unionBounds(oldBounds, newBounds))
        }

        requestRedraw()
    }

    fun undo() {
        synchronized(lock) {
            if (undoStack.isEmpty()) return

            val current = snapshotModelLocked()
            val previous = undoStack.removeAt(undoStack.lastIndex)
            redoStack.add(current)

            restoreModelDirtyLocked(previous)
        }

        requestRedraw()
    }

    fun redo() {
        synchronized(lock) {
            if (redoStack.isEmpty()) return

            val current = snapshotModelLocked()
            val next = redoStack.removeAt(redoStack.lastIndex)
            undoStack.add(current)

            restoreModelDirtyLocked(next)
        }

        requestRedraw()
    }

    fun clear() {
        synchronized(lock) {
            knownRevisions.clear()
            strokes.clear()
            undoStack.clear()
            redoStack.clear()

            pending.clear()
            committed.clear()
            lru.clear()
            currentVisibleTiles = emptySet()

            commitThreadIds.clear()
            submittedTileKeys.clear()
            evictedTiles.clear()
            rejectedCommitCount = 0L

            sceneGeneration++
            cacheGeneration++
        }

        requestRedraw()
    }

    fun renderSnapshot(width: Int, height: Int): Bitmap {
        require(width > 0) { "width must be > 0" }
        require(height > 0) { "height must be > 0" }

        val snapshot = synchronized(lock) {
            makeRenderSnapshotLocked(
                width = width,
                height = height,
                markReadForLru = true
            )
        }

        val bitmap = Bitmap.createBitmap(width, height, Bitmap.Config.ARGB_8888)
        val canvas = AndroidCanvas(bitmap)
        renderSnapshotToCanvas(canvas, snapshot)
        return bitmap
    }

    fun debugState(): StrokeCanvasDebugState {
        return synchronized(lock) {
            StrokeCanvasDebugState(
                sceneGeneration = sceneGeneration,
                viewportGeneration = viewportGeneration,
                committedTiles = committed.keys.toSet(),
                pendingTiles = pending.keys.toSet(),
                activeStrokeIds = strokes.keys.toSet(),
                mainThreadId = mainThreadId,
                commitThreadIds = commitThreadIds.toList(),
                submittedJobCount = submittedJobCount,
                submittedTileKeys = submittedTileKeys.toList(),
                rejectedCommitCount = rejectedCommitCount,
                evictedTiles = evictedTiles.toList()
            )
        }
    }

    internal fun scheduleVisibleTiles(width: Int, height: Int) {
        if (width <= 0 || height <= 0) return

        val jobs = synchronized(lock) {
            lastComposeWidth = width
            lastComposeHeight = height
            prepareJobsLocked(width, height)
        }

        for (job in jobs) {
            rasterExecutor.execute {
                val bitmap = rasterizeTile(job)
                mainHandler.post {
                    commitTile(job, bitmap)
                }
            }
        }
    }

    internal fun drawCommittedTo(
        canvas: AndroidCanvas,
        width: Int,
        height: Int
    ) {
        if (width <= 0 || height <= 0) return

        val snapshot = synchronized(lock) {
            lastComposeWidth = width
            lastComposeHeight = height
            refreshVisibleTilesLocked()

            makeRenderSnapshotLocked(
                width = width,
                height = height,
                markReadForLru = true
            )
        }

        renderSnapshotToCanvas(canvas, snapshot)
    }

    private fun prepareJobsLocked(width: Int, height: Int): List<RasterJob> {
        refreshVisibleTilesLocked()

        for (key in currentVisibleTiles) {
            if (committed.containsKey(key)) {
                markUsedLocked(key)
            }
        }

        val visible = visibleTiles(width, height)
        val prefetch = prefetchTiles(visible)

        val orderedKeys =
            visible.sortedRowMajor() +
                prefetch.filter { it !in visible }.sortedRowMajor()

        val jobs = ArrayList<RasterJob>()

        for (key in orderedKeys) {
            if (committed.containsKey(key)) continue
            if (pending.containsKey(key)) continue

            val tileRect = tileRect(key)
            val relevant = strokes.values
                .sortedBy { it.order }
                .filter { stroke ->
                    val bounds = screenBoundsForStrokeLocked(stroke)
                    bounds != null && rectsIntersect(bounds, tileRect)
                }

            val capturedRevisions = relevant.associate { it.id to it.revision }

            val jobId = nextJobId++

            val job = RasterJob(
                jobId = jobId,
                key = key,
                viewportGeneration = viewportGeneration,
                cacheGeneration = cacheGeneration,
                scale = scale,
                offsetX = offsetX,
                offsetY = offsetY,
                strokes = relevant.map { it.copyForJob() },
                capturedRevisions = capturedRevisions
            )

            pending[key] = PendingTile(
                jobId = jobId,
                viewportGeneration = viewportGeneration,
                cacheGeneration = cacheGeneration
            )

            submittedJobCount++
            submittedTileKeys.add(key)

            jobs.add(job)
        }

        evictIfNeededLocked()
        return jobs
    }

    private fun commitTile(job: RasterJob, bitmap: Bitmap) {
        var committedSomething = false

        synchronized(lock) {
            if (job.viewportGeneration != viewportGeneration) {
                rejectedCommitCount++
                return
            }

            if (job.cacheGeneration != cacheGeneration) {
                rejectedCommitCount++
                return
            }

            val pendingTile = pending[job.key]

            if (pendingTile == null || pendingTile.jobId != job.jobId) {
                rejectedCommitCount++
                return
            }

            if (
                pendingTile.viewportGeneration != job.viewportGeneration ||
                pendingTile.cacheGeneration != job.cacheGeneration
            ) {
                rejectedCommitCount++
                return
            }

            for ((strokeId, capturedRevision) in job.capturedRevisions) {
                if (knownRevisions[strokeId] != capturedRevision) {
                    pending.remove(job.key)
                    rejectedCommitCount++
                    return
                }
            }

            pending.remove(job.key)

            committed[job.key] = TileBitmap(
                key = job.key,
                bitmap = bitmap,
                viewportGeneration = job.viewportGeneration,
                cacheGeneration = job.cacheGeneration,
                representedRevisions = job.capturedRevisions.toMap()
            )

            markUsedLocked(job.key)
            commitThreadIds.add(Thread.currentThread().id)

            refreshVisibleTilesLocked()
            evictIfNeededLocked()

            committedSomething = true
        }

        if (committedSomething) {
            requestRedraw()
        }
    }

    private fun rasterizeTile(job: RasterJob): Bitmap {
        val bitmap = Bitmap.createBitmap(
            TILE_SIZE,
            TILE_SIZE,
            Bitmap.Config.ARGB_8888
        )

        val canvas = AndroidCanvas(bitmap)
        canvas.drawColor(BACKGROUND_COLOR)

        canvas.save()
        canvas.clipRect(0, 0, TILE_SIZE, TILE_SIZE)

        val tileLeft = job.key.x * TILE_SIZE
        val tileTop = job.key.y * TILE_SIZE
        canvas.translate(-tileLeft.toFloat(), -tileTop.toFloat())

        val strokePaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
            style = Paint.Style.STROKE
            strokeCap = Paint.Cap.ROUND
            strokeJoin = Paint.Join.ROUND
        }

        val fillPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
            style = Paint.Style.FILL
        }

        for (stroke in job.strokes.sortedBy { it.order }) {
            drawStrokeOnCanvas(
                canvas = canvas,
                stroke = stroke,
                scale = job.scale,
                offsetX = job.offsetX,
                offsetY = job.offsetY,
                strokePaint = strokePaint,
                fillPaint = fillPaint
            )
        }

        canvas.restore()
        return bitmap
    }

    private fun makeRenderSnapshotLocked(
        width: Int,
        height: Int,
        markReadForLru: Boolean
    ): RenderSnapshot {
        val visible = visibleTiles(width, height)

        if (markReadForLru) {
            for (key in visible) {
                if (committed.containsKey(key)) {
                    markUsedLocked(key)
                }
            }
        }

        return RenderSnapshot(
            width = width,
            height = height,
            scale = scale,
            offsetX = offsetX,
            offsetY = offsetY,
            visibleTiles = visible,
            tiles = committed.values.map {
                SnapshotTile(
                    key = it.key,
                    bitmap = it.bitmap,
                    representedRevisions = it.representedRevisions.toMap()
                )
            },
            strokes = strokes.values
                .sortedBy { it.order }
                .map { it.copyForJob() }
        )
    }

    private fun renderSnapshotToCanvas(
        canvas: AndroidCanvas,
        snapshot: RenderSnapshot
    ) {
        canvas.drawColor(BACKGROUND_COLOR)

        val tileMap = snapshot.tiles.associateBy { it.key }

        for (tile in snapshot.tiles.sortedWith(compareBy<SnapshotTile> { it.key.y }.thenBy { it.key.x })) {
            val left = tile.key.x * TILE_SIZE
            val top = tile.key.y * TILE_SIZE

            if (left >= snapshot.width || top >= snapshot.height) continue
            if (left + TILE_SIZE <= 0 || top + TILE_SIZE <= 0) continue

            canvas.drawBitmap(
                tile.bitmap,
                left.toFloat(),
                top.toFloat(),
                null
            )
        }

        drawLiveOverlay(
            canvas = canvas,
            snapshot = snapshot,
            tileMap = tileMap
        )
    }

    private fun drawLiveOverlay(
        canvas: AndroidCanvas,
        snapshot: RenderSnapshot,
        tileMap: Map<TileKey, SnapshotTile>
    ) {
        val strokePaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
            style = Paint.Style.STROKE
            strokeCap = Paint.Cap.ROUND
            strokeJoin = Paint.Join.ROUND
        }

        val fillPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
            style = Paint.Style.FILL
        }

        for (tileKey in snapshot.visibleTiles.sortedRowMajor()) {
            val tileRect = tileRect(tileKey)
            val committedTile = tileMap[tileKey]

            canvas.save()
            canvas.clipRect(tileRect)

            for (stroke in snapshot.strokes.sortedBy { it.order }) {
                if (stroke.ended) continue

                val strokeBounds = screenBoundsForStroke(
                    stroke = stroke,
                    scale = snapshot.scale,
                    offsetX = snapshot.offsetX,
                    offsetY = snapshot.offsetY
                )

                if (strokeBounds == null || !rectsIntersect(strokeBounds, tileRect)) {
                    continue
                }

                val committedRevision =
                    committedTile?.representedRevisions?.get(stroke.id)

                if (committedRevision == stroke.revision) {
                    continue
                }

                drawStrokeOnCanvas(
                    canvas = canvas,
                    stroke = stroke,
                    scale = snapshot.scale,
                    offsetX = snapshot.offsetX,
                    offsetY = snapshot.offsetY,
                    strokePaint = strokePaint,
                    fillPaint = fillPaint
                )
            }

            canvas.restore()
        }
    }

    private fun drawStrokeOnCanvas(
        canvas: AndroidCanvas,
        stroke: JobStroke,
        scale: Float,
        offsetX: Float,
        offsetY: Float,
        strokePaint: Paint,
        fillPaint: Paint
    ) {
        if (stroke.points.isEmpty()) return

        if (stroke.points.size == 1) {
            val point = stroke.points[0]
            val radius = stroke.widthPx * point.pressure / 2f
            if (radius <= 0f) return

            fillPaint.color = stroke.color

            val sx = (point.x - offsetX) * scale
            val sy = (point.y - offsetY) * scale

            canvas.drawCircle(sx, sy, radius, fillPaint)
            return
        }

        strokePaint.color = stroke.color

        for (index in 1 until stroke.points.size) {
            val a = stroke.points[index - 1]
            val b = stroke.points[index]

            val width = stroke.widthPx * ((a.pressure + b.pressure) / 2f)
            if (width <= 0f) continue

            strokePaint.strokeWidth = width

            val ax = (a.x - offsetX) * scale
            val ay = (a.y - offsetY) * scale
            val bx = (b.x - offsetX) * scale
            val by = (b.y - offsetY) * scale

            canvas.drawLine(ax, ay, bx, by, strokePaint)
        }
    }

    private fun refreshVisibleTilesLocked() {
        currentVisibleTiles =
            if (lastComposeWidth > 0 && lastComposeHeight > 0) {
                visibleTiles(lastComposeWidth, lastComposeHeight)
            } else {
                emptySet()
            }
    }

    private fun visibleTiles(width: Int, height: Int): Set<TileKey> {
        if (width <= 0 || height <= 0) return emptySet()

        val maxX = floor((width - 1).toFloat() / TILE_SIZE.toFloat()).toInt()
        val maxY = floor((height - 1).toFloat() / TILE_SIZE.toFloat()).toInt()

        val result = LinkedHashSet<TileKey>()

        for (y in 0..maxY) {
            for (x in 0..maxX) {
                result.add(TileKey(x, y))
            }
        }

        return result
    }

    private fun prefetchTiles(visible: Set<TileKey>): Set<TileKey> {
        if (visible.isEmpty()) return emptySet()

        val minX = visible.minOf { it.x }
        val maxX = visible.maxOf { it.x }
        val minY = visible.minOf { it.y }
        val maxY = visible.maxOf { it.y }

        val result = LinkedHashSet<TileKey>()

        for (y in (minY - 1)..(maxY + 1)) {
            for (x in (minX - 1)..(maxX + 1)) {
                result.add(TileKey(x, y))
            }
        }

        return result
    }

    private fun Collection<TileKey>.sortedRowMajor(): List<TileKey> {
        return sortedWith(compareBy<TileKey> { it.y }.thenBy { it.x })
    }

    private fun evictIfNeededLocked() {
        while (committed.size > maxCachedTiles) {
            val candidates = committed.keys.filter { it !in currentVisibleTiles }

            if (candidates.isEmpty()) {
                return
            }

            val victim = candidates.minByOrNull { key ->
                lru[key] ?: Long.MIN_VALUE
            } ?: return

            committed.remove(victim)
            lru.remove(victim)
            evictedTiles.add(victim)
        }
    }

    private fun invalidateTilesForBoundsLocked(bounds: RectF?) {
        if (bounds == null) return
        if (bounds.right <= bounds.left || bounds.bottom <= bounds.top) return

        val epsilon = 0.001f

        val minX = floor(bounds.left / TILE_SIZE.toFloat()).toInt()
        val maxX = floor((bounds.right - epsilon) / TILE_SIZE.toFloat()).toInt()
        val minY = floor(bounds.top / TILE_SIZE.toFloat()).toInt()
        val maxY = floor((bounds.bottom - epsilon) / TILE_SIZE.toFloat()).toInt()

        for (y in minY..maxY) {
            for (x in minX..maxX) {
                val key = TileKey(x, y)
                committed.remove(key)
                pending.remove(key)
                lru.remove(key)
            }
        }

        evictIfNeededLocked()
    }

    private fun screenBoundsForStrokeLocked(stroke: StrokeRecord): RectF? {
        return screenBoundsForStroke(
            stroke = stroke.copyForJob(),
            scale = scale,
            offsetX = offsetX,
            offsetY = offsetY
        )
    }

    private fun screenBoundsForPointsLocked(
        points: List<StrokePoint>,
        widthPx: Float
    ): RectF? {
        return screenBoundsForPoints(
            points = points,
            widthPx = widthPx,
            scale = scale,
            offsetX = offsetX,
            offsetY = offsetY
        )
    }

    private fun restoreModelDirtyLocked(target: ModelSnapshot) {
        val current = strokes.values.map { it.copyForSnapshot() }
        val targetStrokes = target.strokes.map { it.copyForSnapshot() }

        val currentById = current.associateBy { it.id }
        val targetById = targetStrokes.associateBy { it.id }

        val changedIds = LinkedHashSet<String>()
        changedIds.addAll(currentById.keys)
        changedIds.addAll(targetById.keys)

        val actuallyChanged = changedIds.filter { id ->
            !sameVisual(currentById[id], targetById[id])
        }.toSet()

        var dirtyBounds: RectF? = null

        for (id in actuallyChanged) {
            dirtyBounds = unionBounds(
                dirtyBounds,
                currentById[id]?.let { screenBoundsForStrokeLocked(it) }
            )
            dirtyBounds = unionBounds(
                dirtyBounds,
                targetById[id]?.let { screenBoundsForStrokeLocked(it) }
            )
        }

        strokes.clear()

        val targetIds = targetStrokes.map { it.id }.toSet()

        for (stroke in targetStrokes.sortedBy { it.order }) {
            val revision =
                if (stroke.id in actuallyChanged) {
                    nextRevisionLocked(stroke.id)
                } else {
                    val existing = knownRevisions[stroke.id] ?: stroke.revision
                    knownRevisions[stroke.id] = max(existing, stroke.revision)
                    existing
                }

            strokes[stroke.id] = stroke.copy(
                points = stroke.points.toList(),
                revision = revision
            )
        }

        for (id in actuallyChanged) {
            if (id !in targetIds) {
                nextRevisionLocked(id)
            }
        }

        nextOrder = target.nextOrder
        sceneGeneration++

        invalidateTilesForBoundsLocked(dirtyBounds)
    }

    private fun sameVisual(a: StrokeRecord?, b: StrokeRecord?): Boolean {
        if (a == null || b == null) return a == b

        return a.id == b.id &&
            a.color == b.color &&
            a.widthPx == b.widthPx &&
            a.points == b.points &&
            a.ended == b.ended &&
            a.order == b.order
    }

    private fun pushUndoLocked() {
        undoStack.add(snapshotModelLocked())
    }

    private fun snapshotModelLocked(): ModelSnapshot {
        return ModelSnapshot(
            strokes = strokes.values.map { it.copyForSnapshot() },
            nextOrder = nextOrder
        )
    }

    private fun nextRevisionLocked(strokeId: String): Long {
        val next = (knownRevisions[strokeId] ?: -1L) + 1L
        knownRevisions[strokeId] = next
        return next
    }

    private fun markUsedLocked(key: TileKey) {
        lruClock++
        lru[key] = lruClock
    }

    private fun requestRedraw() {
        if (Looper.myLooper() == Looper.getMainLooper()) {
            composeVersion++
        } else {
            mainHandler.post {
                composeVersion++
            }
        }
    }

    private fun validateStrokeId(strokeId: String) {
        require(strokeId.isNotEmpty()) {
            "strokeId must be non-empty"
        }
    }

    private fun validateWidth(widthPx: Float) {
        require(widthPx.isFinite() && widthPx > 0f) {
            "widthPx must be finite and > 0"
        }
    }

    private fun validatePoints(points: List<StrokePoint>) {
        for (point in points) {
            require(point.x.isFinite()) { "point.x must be finite" }
            require(point.y.isFinite()) { "point.y must be finite" }
            require(point.pressure.isFinite()) { "point.pressure must be finite" }
            require(point.pressure >= 0f) { "point.pressure must be >= 0" }
        }
    }

    private data class StrokeRecord(
        val id: String,
        val color: Int,
        val widthPx: Float,
        val points: List<StrokePoint>,
        val ended: Boolean,
        val order: Int,
        val revision: Long
    ) {
        fun copyForJob(): JobStroke {
            return JobStroke(
                id = id,
                color = color,
                widthPx = widthPx,
                points = points.toList(),
                ended = ended,
                order = order,
                revision = revision
            )
        }

        fun copyForSnapshot(): StrokeRecord {
            return copy(points = points.toList())
        }
    }

    private data class JobStroke(
        val id: String,
        val color: Int,
        val widthPx: Float,
        val points: List<StrokePoint>,
        val ended: Boolean,
        val order: Int,
        val revision: Long
    )

    private data class ModelSnapshot(
        val strokes: List<StrokeRecord>,
        val nextOrder: Int
    )

    private data class PendingTile(
        val jobId: Long,
        val viewportGeneration: Long,
        val cacheGeneration: Long
    )

    private data class TileBitmap(
        val key: TileKey,
        val bitmap: Bitmap,
        val viewportGeneration: Long,
        val cacheGeneration: Long,
        val representedRevisions: Map<String, Long>
    )

    private data class RasterJob(
        val jobId: Long,
        val key: TileKey,
        val viewportGeneration: Long,
        val cacheGeneration: Long,
        val scale: Float,
        val offsetX: Float,
        val offsetY: Float,
