/* ============================================================
 * PUBLIC CONFIGURATION
 * ============================================================ */

@Immutable
data class MorphingTextAnimationSpec(
    val moveDurationMillis: Int = 200,
) {
    init {
        require(moveDurationMillis >= 0) {
            "moveDurationMillis must be >= 0"
        }
    }
}


/* ============================================================
 * GRAPHEME / MATCH MODELS
 * ============================================================ */

@Immutable
data class Grapheme(
    val text: String,
    val startOffset: Int,
    val endOffset: Int,
)


@Immutable
data class Match(
    val oldIndex: Int,
    val newIndex: Int,
)


fun interface MorphingTextMatcher {
    fun match(
        old: List<Grapheme>,
        new: List<Grapheme>,
    ): List<Match>
}


/* ============================================================
 * DEFAULT MATCHER
 *
 * Deterministic priorities:
 *
 * 1. Reuse maximum number of graphemes.
 * 2. Minimize total index movement.
 * 3. Preserve relative order.
 * 4. Lexicographic tie-break.
 * ============================================================ */

object MinimumMovementMatcher : MorphingTextMatcher {

    private data class Candidate(
        val matches: List<Match>,
        val movementCost: Int,
    )


    override fun match(
        old: List<Grapheme>,
        new: List<Grapheme>,
    ): List<Match> {

        if (old.isEmpty() || new.isEmpty()) {
            return emptyList()
        }

        val memo =
            HashMap<Pair<Int, Int>, Candidate>()


        fun lexicographicCompare(
            first: List<Match>,
            second: List<Match>,
        ): Int {

            val count =
                minOf(
                    first.size,
                    second.size,
                )

            for (index in 0 until count) {
                val a = first[index]
                val b = second[index]

                if (a.oldIndex != b.oldIndex) {
                    return a.oldIndex.compareTo(
                        b.oldIndex
                    )
                }

                if (a.newIndex != b.newIndex) {
                    return a.newIndex.compareTo(
                        b.newIndex
                    )
                }
            }

            return first.size.compareTo(
                second.size
            )
        }


        fun better(
            first: Candidate,
            second: Candidate,
        ): Candidate {

            if (
                first.matches.size !=
                second.matches.size
            ) {
                return if (
                    first.matches.size >
                    second.matches.size
                ) {
                    first
                } else {
                    second
                }
            }

            if (
                first.movementCost !=
                second.movementCost
            ) {
                return if (
                    first.movementCost <
                    second.movementCost
                ) {
                    first
                } else {
                    second
                }
            }

            return if (
                lexicographicCompare(
                    first.matches,
                    second.matches,
                ) <= 0
            ) {
                first
            } else {
                second
            }
        }


        fun solve(
            oldIndex: Int,
            newIndex: Int,
        ): Candidate {

            if (
                oldIndex >= old.size ||
                newIndex >= new.size
            ) {
                return Candidate(
                    matches = emptyList(),
                    movementCost = 0,
                )
            }

            val key =
                oldIndex to newIndex

            memo[key]?.let {
                return it
            }

            /*
             * Remove old grapheme.
             */
            var best =
                solve(
                    oldIndex + 1,
                    newIndex,
                )

            /*
             * Insert new grapheme.
             */
            best =
                better(
                    best,
                    solve(
                        oldIndex,
                        newIndex + 1,
                    ),
                )

            /*
             * Reuse equal grapheme.
             */
            if (
                old[oldIndex].text ==
                new[newIndex].text
            ) {
                val suffix =
                    solve(
                        oldIndex + 1,
                        newIndex + 1,
                    )

                val candidate =
                    Candidate(
                        matches =
                            listOf(
                                Match(
                                    oldIndex,
                                    newIndex,
                                )
                            ) + suffix.matches,

                        movementCost =
                            abs(
                                oldIndex -
                                    newIndex
                            ) +
                                suffix.movementCost,
                    )

                best =
                    better(
                        best,
                        candidate,
                    )
            }

            memo[key] = best

            return best
        }


        return solve(
            oldIndex = 0,
            newIndex = 0,
        ).matches
    }
}


/* ============================================================
 * TRANSITION PLAN
 * ============================================================ */

@Immutable
data class TransitionPlan(
    val oldText: String,
    val newText: String,
    val old: List<Grapheme>,
    val new: List<Grapheme>,
    val matches: List<Match>,
    val removedOldIndices: Set<Int>,
    val insertedNewIndices: Set<Int>,
)


/* ============================================================
 * VISUAL PHASE
 *
 * Removed:
 *     unmatched old glyphs are already gone;
 *     survivors are still at OLD positions.
 *
 * Moving:
 *     survivors interpolate old -> new.
 *
 * Moved:
 *     survivors are at NEW positions;
 *     inserted glyphs are still absent.
 *
 * Stable:
 *     represented by activeTransition == null.
 * ============================================================ */

private enum class MorphPhase {
    Removed,
    Moving,
    Moved,
}


@Immutable
private data class ActiveTransition(
    val plan: TransitionPlan,
    val spec: MorphingTextAnimationSpec,
    val phase: MorphPhase,
)


/* ============================================================
 * MORPHING TEXT
 * ============================================================ */

@Composable
fun MorphingText(
    text: String,
    modifier: Modifier = Modifier,
    style: TextStyle = LocalTextStyle.current,
    animationSpec: MorphingTextAnimationSpec =
        MorphingTextAnimationSpec(),
    matcher: MorphingTextMatcher =
        MinimumMovementMatcher,
) {

    val textMeasurer =
        rememberTextMeasurer(
            cacheSize = 64
        )


    /*
     * Only changes when an entire transition completes.
     */
    var committedText by remember {
        mutableStateOf(text)
    }


    /*
     * null means stable.
     */
    var activeTransition by remember {
        mutableStateOf<ActiveTransition?>(null)
    }


    /*
     * Only MOVE is animated.
     *
     * 0 = old survivor positions
     * 1 = new survivor positions
     */
    val moveProgress =
        remember {
            Animatable(0f)
        }


    /*
     * Finish-current / keep-latest queue.
     */
    val requests =
        remember {
            Channel<String>(
                capacity = Channel.CONFLATED
            )
        }


    val latestSpec by
        rememberUpdatedState(
            animationSpec
        )


    val latestMatcher by
        rememberUpdatedState(
            matcher
        )


    /* ========================================================
     * PRODUCER
     *
     * Intentionally enqueue EVERY target change.
     *
     * Example:
     *
     * committed A
     * active A -> B
     * parent changes target back to A
     *
     * A must remain queued so after B completes we perform
     * B -> A.
     * ======================================================== */

    LaunchedEffect(text) {
        requests.trySend(text)
    }


    /* ========================================================
     * LONG-LIVED WORKER
     * ======================================================== */

    LaunchedEffect(Unit) {

        for (destination in requests) {

            if (
                destination ==
                committedText
            ) {
                continue
            }


            val spec =
                latestSpec

            val transitionMatcher =
                latestMatcher


            val plan =
                createTransitionPlan(
                    oldText =
                        committedText,
                    newText =
                        destination,
                    matcher =
                        transitionMatcher,
                )


            /*
             * Reset BEFORE exposing transition.
             */
            moveProgress.snapTo(0f)


            /* =================================================
             * REMOVE
             *
             * Removed letters disappear immediately.
             *
             * Survivors remain at old positions.
             * ================================================= */

            activeTransition =
                ActiveTransition(
                    plan = plan,
                    spec = spec,
                    phase = MorphPhase.Removed,
                )


            /*
             * IMPORTANT:
             *
             * Hold Removed for one actual Compose frame.
             *
             * Therefore there is a real renderable frame where:
             *
             * - removed letters are gone
             * - survivors have NOT moved
             * - inserted letters are NOT visible
             *
             * This is the screenshot-test boundary.
             */
            withFrameMillis {
                // Frame boundary only.
            }


            /* =================================================
             * MOVE
             * ================================================= */

            activeTransition =
                ActiveTransition(
                    plan = plan,
                    spec = spec,
                    phase = MorphPhase.Moving,
                )


            if (
                spec.moveDurationMillis == 0
            ) {

                moveProgress.snapTo(1f)

            } else {

                moveProgress.animateTo(
                    targetValue = 1f,
                    animationSpec =
                        tween(
                            durationMillis =
                                spec.moveDurationMillis,
                            delayMillis = 0,
                            easing = LinearEasing,
                        ),
                )
            }


            /* =================================================
             * MOVED
             *
             * Survivors have reached final positions.
             * New letters are still absent.
             * ================================================= */

            activeTransition =
                ActiveTransition(
                    plan = plan,
                    spec = spec,
                    phase = MorphPhase.Moved,
                )


            /*
             * Again expose this as a real rendered frame.
             *
             * This gives tests a second useful boundary:
             *
             * survivors moved,
             * inserted letters still absent.
             */
            withFrameMillis {
                // Frame boundary only.
            }


            /* =================================================
             * INSERT + COMMIT
             *
             * Insert is instant.
             *
             * We don't need a separate "Inserted" phase because
             * the final stable full-layout rendering is exactly
             * the desired inserted state.
             * ================================================= */

            committedText =
                destination

            activeTransition =
                null
        }
    }


    /* ========================================================
     * CURRENT VISUAL WORDS
     * ======================================================== */

    val transition =
        activeTransition


    val visualOldText =
        transition
            ?.plan
            ?.oldText
            ?: committedText


    val visualNewText =
        transition
            ?.plan
            ?.newText
            ?: committedText


    /* ========================================================
     * SEGMENT
     * ======================================================== */

    val oldGraphemes =
        remember(
            visualOldText
        ) {
            segmentGraphemes(
                visualOldText
            )
        }


    val newGraphemes =
        remember(
            visualNewText
        ) {
            segmentGraphemes(
                visualNewText
            )
        }


    /* ========================================================
     * MEASURE
     * ======================================================== */

    val oldWord =
        remember(
            visualOldText,
            style,
            textMeasurer,
        ) {
            measureWord(
                text =
                    visualOldText,
                graphemes =
                    oldGraphemes,
                textMeasurer =
                    textMeasurer,
                style =
                    style,
            )
        }


    val newWord =
        remember(
            visualNewText,
            style,
            textMeasurer,
        ) {
            measureWord(
                text =
                    visualNewText,
                graphemes =
                    newGraphemes,
                textMeasurer =
                    textMeasurer,
                style =
                    style,
            )
        }


    /*
     * Keep size stable for the complete transition.
     */
    val widthPx =
        max(
            oldWord.width,
            newWord.width,
        )


    val heightPx =
        max(
            oldWord.height,
            newWord.height,
        )


    val density =
        LocalDensity.current


    val widthDp =
        with(density) {
            widthPx.toDp()
        }


    val heightDp =
        with(density) {
            heightPx.toDp()
        }


    /* ========================================================
     * DRAW
     * ======================================================== */

    Canvas(
        modifier =
            modifier
                .requiredSize(
                    width = widthDp,
                    height = heightDp,
                )
                .semantics {

                    /*
                     * Destination isn't announced before the
                     * entire transition finishes.
                     */
                    this.text =
                        AnnotatedString(
                            committedText
                        )
                }
    ) {

        val currentTransition =
            activeTransition


        if (
            currentTransition == null
        ) {

            drawStableWord(
                oldWord
            )

            return@Canvas
        }


        /*
         * Read animation state in DRAW.
         *
         * Compose tracks draw-phase state reads and invalidates
         * drawing when the value changes.
         */
        val progress =
            when (
                currentTransition.phase
            ) {

                MorphPhase.Removed ->
                    0f

                MorphPhase.Moving ->
                    moveProgress.value

                MorphPhase.Moved ->
                    1f
            }


        drawTransition(
            plan =
                currentTransition.plan,
            oldWord =
                oldWord,
            newWord =
                newWord,
            moveProgress =
                progress,
        )
    }
}


/* ============================================================
 * GRAPHEME SEGMENTATION
 * ============================================================ */

internal fun segmentGraphemes(
    text: String,
    locale: Locale =
        Locale.getDefault(),
): List<Grapheme> {

    if (
        text.isEmpty()
    ) {
        return emptyList()
    }


    val iterator =
        BreakIterator
            .getCharacterInstance(
                locale
            )


    iterator.setText(
        text
    )


    val result =
        ArrayList<Grapheme>()


    var start =
        iterator.first()


    var end =
        iterator.next()


    while (
        end !=
        BreakIterator.DONE
    ) {

        result +=
            Grapheme(
                text =
                    text.substring(
                        start,
                        end,
                    ),
                startOffset =
                    start,
                endOffset =
                    end,
            )


        start =
            end

        end =
            iterator.next()
    }


    return result
}


/* ============================================================
 * TRANSITION PLANNER
 * ============================================================ */

internal fun createTransitionPlan(
    oldText: String,
    newText: String,
    matcher: MorphingTextMatcher =
        MinimumMovementMatcher,
): TransitionPlan {

    val old =
        segmentGraphemes(
            oldText
        )


    val new =
        segmentGraphemes(
            newText
        )


    val matches =
        matcher.match(
            old = old,
            new = new,
        )


    validateMatches(
        old = old,
        new = new,
        matches = matches,
    )


    val matchedOldIndices =
        matches.mapTo(
            HashSet()
        ) {
            it.oldIndex
        }


    val matchedNewIndices =
        matches.mapTo(
            HashSet()
        ) {
            it.newIndex
        }


    val removedOldIndices =
        old.indices
            .filterTo(
                LinkedHashSet()
            ) {
                it !in matchedOldIndices
            }


    val insertedNewIndices =
        new.indices
            .filterTo(
                LinkedHashSet()
            ) {
                it !in matchedNewIndices
            }


    return TransitionPlan(
        oldText =
            oldText,
        newText =
            newText,
        old =
            old,
        new =
            new,
        matches =
            matches,
        removedOldIndices =
            removedOldIndices,
        insertedNewIndices =
            insertedNewIndices,
    )
}


/* ============================================================
 * MATCH VALIDATION
 * ============================================================ */

private fun validateMatches(
    old: List<Grapheme>,
    new: List<Grapheme>,
    matches: List<Match>,
) {

    var previousOld =
        -1

    var previousNew =
        -1


    val seenOld =
        HashSet<Int>()

    val seenNew =
        HashSet<Int>()


    for (
        match in matches
    ) {

        require(
            match.oldIndex in old.indices
        ) {
            "Invalid oldIndex=${match.oldIndex}"
        }


        require(
            match.newIndex in new.indices
        ) {
            "Invalid newIndex=${match.newIndex}"
        }


        require(
            seenOld.add(
                match.oldIndex
            )
        ) {
            "oldIndex=${match.oldIndex} matched more than once"
        }


        require(
            seenNew.add(
                match.newIndex
            )
        ) {
            "newIndex=${match.newIndex} matched more than once"
        }


        require(
            old[
                match.oldIndex
            ].text ==
                new[
                    match.newIndex
                ].text
        ) {
            "Matcher matched different graphemes"
        }


        require(
            match.oldIndex >
                previousOld
        ) {
            "old match indices must be strictly increasing"
        }


        require(
            match.newIndex >
                previousNew
        ) {
            "new match indices must be strictly increasing"
        }


        previousOld =
            match.oldIndex

        previousNew =
            match.newIndex
    }
}


/* ============================================================
 * MEASUREMENT
 * ============================================================ */

private data class MeasuredGrapheme(
    val grapheme: Grapheme,
    val x: Float,
    val layout: TextLayoutResult,
)


private data class MeasuredWord(
    val fullLayout: TextLayoutResult?,
    val graphemes: List<MeasuredGrapheme>,
    val width: Float,
    val height: Float,
)


private fun measureWord(
    text: String,
    graphemes: List<Grapheme>,
    textMeasurer: TextMeasurer,
    style: TextStyle,
): MeasuredWord {

    /*
     * Preserve sensible line height for empty strings.
     */
    if (
        text.isEmpty()
    ) {

        val probe =
            textMeasurer.measure(
                text =
                    AnnotatedString(
                        "Mg"
                    ),
                style =
                    style,
                softWrap =
                    false,
                maxLines =
                    1,
                constraints =
                    Constraints(),
            )


        return MeasuredWord(
            fullLayout =
                null,
            graphemes =
                emptyList(),
            width =
                0f,
            height =
                probe
                    .size
                    .height
                    .toFloat(),
        )
    }


    /*
     * Full-word measurement determines real positions.
     */
    val fullLayout =
        textMeasurer.measure(
            text =
                AnnotatedString(
                    text
                ),
            style =
                style,
            softWrap =
                false,
            maxLines =
                1,
            constraints =
                Constraints(),
        )


    val measuredGraphemes =
        graphemes.map {
                grapheme ->

            val boundingBox =
                fullLayout.getBoundingBox(
                    grapheme.startOffset
                )


            /*
             * Separate layout so each surviving grapheme can
             * move independently.
             */
            val isolatedLayout =
                textMeasurer.measure(
                    text =
                        AnnotatedString(
                            grapheme.text
                        ),
                    style =
                        style,
                    softWrap =
                        false,
                    maxLines =
                        1,
                    constraints =
                        Constraints(),
                )


            MeasuredGrapheme(
                grapheme =
                    grapheme,
                x =
                    boundingBox.left,
                layout =
                    isolatedLayout,
            )
        }


    return MeasuredWord(
        fullLayout =
            fullLayout,
        graphemes =
            measuredGraphemes,
        width =
            fullLayout
                .size
                .width
                .toFloat(),
        height =
            fullLayout
                .size
                .height
                .toFloat(),
    )
}


/* ============================================================
 * STABLE RENDERER
 * ============================================================ */

private fun DrawScope.drawStableWord(
    word: MeasuredWord,
) {

    val layout =
        word.fullLayout
            ?: return


    drawText(
        textLayoutResult =
            layout,
        topLeft =
            Offset.Zero,
    )
}


/* ============================================================
 * TRANSITION RENDERER
 *
 * There is NO fade.
 *
 * Unmatched old glyphs:
 *     never drawn.
 *
 * Matched old glyphs:
 *     drawn once and moved oldX -> newX.
 *
 * Unmatched new glyphs:
 *     never drawn during transition.
 *
 * They appear only when the transition commits.
 * ============================================================ */

private fun DrawScope.drawTransition(
    plan: TransitionPlan,
    oldWord: MeasuredWord,
    newWord: MeasuredWord,
    moveProgress: Float,
) {

    val matchByOldIndex =
        plan.matches
            .associateBy {
                it.oldIndex
            }


    val progress =
        moveProgress.coerceIn(
            0f,
            1f,
        )


    oldWord.graphemes
        .forEachIndexed {
                oldIndex,
                oldGrapheme ->

            val match =
                matchByOldIndex[
                    oldIndex
                ]


            /*
             * REMOVE:
             *
             * unmatched old glyph simply isn't rendered.
             */
            if (
                match == null
            ) {
                return@forEachIndexed
            }


            /*
             * This survivor remains the SAME visual object.
             *
             * We don't render its new counterpart separately.
             */
            val destination =
                newWord.graphemes[
                    match.newIndex
                ]


            val x =
                lerp(
                    start =
                        oldGrapheme.x,
                    end =
                        destination.x,
                    fraction =
                        progress,
                )


            drawGrapheme(
                grapheme =
                    oldGrapheme,
                x =
                    x,
            )
        }


    /*
     * Notice:
     *
     * There is intentionally NO loop drawing inserted new
     * graphemes here.
     *
     * They remain absent throughout Removed / Moving / Moved.
     *
     * INSERT occurs when committedText changes and the stable
     * full new word is rendered.
     */
}


/* ============================================================
 * DRAW ONE GRAPHEME
 * ============================================================ */

private fun DrawScope.drawGrapheme(
    grapheme: MeasuredGrapheme,
    x: Float,
) {

    drawText(
        textLayoutResult =
            grapheme.layout,
        topLeft =
            Offset(
                x = x,
                y = 0f,
            ),
    )
}


/* ============================================================
 * PURE INTERPOLATION
 * ============================================================ */

internal fun lerp(
    start: Float,
    end: Float,
    fraction: Float,
): Float {

    val progress =
        fraction.coerceIn(
            0f,
            1f,
        )


    return start +
        (
            end -
                start
        ) *
        progress
}
