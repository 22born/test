/* ============================================================
 * PUBLIC API
 * ============================================================ */

@Immutable
data class MorphingTextAnimationSpec(
    val exitDurationMillis: Int = 100,
    val moveDurationMillis: Int = 200,
    val enterDurationMillis: Int = 100,
    val moveEasing: Easing = FastOutSlowInEasing,
    val fadeEasing: Easing = LinearEasing,
) {
    init {
        require(exitDurationMillis >= 0)
        require(moveDurationMillis >= 0)
        require(enterDurationMillis >= 0)
    }

    val totalDurationMillis: Int
        get() =
            exitDurationMillis +
                moveDurationMillis +
                enterDurationMillis
}


fun interface MorphingTextMatcher {
    fun match(
        old: List<Grapheme>,
        new: List<Grapheme>,
    ): List<Match>
}


/* ============================================================
 * DETERMINISTIC MATCHER
 * ============================================================ */

object MinimumMovementMatcher : MorphingTextMatcher {

    private data class Candidate(
        val matches: List<Match>,
        val movementCost: Int,
    )

    override fun match(
        old: List<Grapheme>,
        new: List<Grapheme>,
    ): List<Match> {

        if (old.isEmpty() || new.isEmpty()) {
            return emptyList()
        }

        val memo =
            HashMap<Pair<Int, Int>, Candidate>()

        fun compareLists(
            a: List<Match>,
            b: List<Match>,
        ): Int {

            val size =
                minOf(a.size, b.size)

            for (i in 0 until size) {

                val x = a[i]
                val y = b[i]

                if (x.oldIndex != y.oldIndex) {
                    return x.oldIndex.compareTo(
                        y.oldIndex
                    )
                }

                if (x.newIndex != y.newIndex) {
                    return x.newIndex.compareTo(
                        y.newIndex
                    )
                }
            }

            return a.size.compareTo(b.size)
        }

        fun better(
            a: Candidate,
            b: Candidate,
        ): Candidate {

            if (a.matches.size != b.matches.size) {
                return if (
                    a.matches.size > b.matches.size
                ) a else b
            }

            if (a.movementCost != b.movementCost) {
                return if (
                    a.movementCost < b.movementCost
                ) a else b
            }

            return if (
                compareLists(
                    a.matches,
                    b.matches,
                ) <= 0
            ) a else b
        }

        fun solve(
            oldIndex: Int,
            newIndex: Int,
        ): Candidate {

            if (
                oldIndex >= old.size ||
                newIndex >= new.size
            ) {
                return Candidate(
                    matches = emptyList(),
                    movementCost = 0,
                )
            }

            val key =
                oldIndex to newIndex

            memo[key]?.let {
                return it
            }

            /*
             * Remove old.
             */
            var best =
                solve(
                    oldIndex + 1,
                    newIndex,
                )

            /*
             * Insert new.
             */
            best =
                better(
                    best,
                    solve(
                        oldIndex,
                        newIndex + 1,
                    ),
                )

            /*
             * Reuse.
             */
            if (
                old[oldIndex].text ==
                new[newIndex].text
            ) {

                val suffix =
                    solve(
                        oldIndex + 1,
                        newIndex + 1,
                    )

                val candidate =
                    Candidate(
                        matches =
                            listOf(
                                Match(
                                    oldIndex,
                                    newIndex,
                                )
                            ) + suffix.matches,

                        movementCost =
                            abs(
                                oldIndex -
                                    newIndex
                            ) +
                                suffix.movementCost,
                    )

                best =
                    better(
                        best,
                        candidate,
                    )
            }

            memo[key] = best

            return best
        }

        return solve(0, 0).matches
    }
}


/* ============================================================
 * COMPOSABLE
 * ============================================================ */

@Composable
fun MorphingText(
    text: String,
    modifier: Modifier = Modifier,
    style: TextStyle = LocalTextStyle.current,
    animationSpec: MorphingTextAnimationSpec =
        MorphingTextAnimationSpec(),
    matcher: MorphingTextMatcher =
        MinimumMovementMatcher,
) {

    val textMeasurer =
        rememberTextMeasurer(
            cacheSize = 64
        )

    /*
     * The word that has COMPLETELY finished animating.
     */
    var committedText by remember {
        mutableStateOf(text)
    }

    /*
     * Current transition.
     *
     * null = stable.
     */
    var activePlan by remember {
        mutableStateOf<TransitionPlan?>(null)
    }

    /*
     * Capture the spec actually used by the active transition.
     *
     * This is important:
     * changing animationSpec halfway through an animation should
     * not change the interpretation of its existing progress.
     */
    var activeSpec by remember {
        mutableStateOf(animationSpec)
    }

    /*
     * One normalized animation value.
     */
    val progress =
        remember {
            Animatable(1f)
        }

    /*
     * Conflated channel:
     *
     * while an animation is running, repeated target changes
     * collapse to the latest value.
     *
     * chair -> care
     *
     * while running:
     * card
     * hard
     * hair
     *
     * worker receives:
     *
     * care -> hair
     *
     * rather than every intermediate value.
     */
    val requests =
        remember {
            Channel<String>(
                capacity =
                    Channel.CONFLATED
            )
        }

    /*
     * Keep latest configuration accessible without restarting
     * the worker.
     */
    val currentSpec by
        rememberUpdatedState(
            animationSpec
        )

    val currentMatcher by
        rememberUpdatedState(
            matcher
        )


    /* ========================================================
     * PRODUCER
     *
     * Incoming public `text` changes are converted into requests.
     *
     * This effect is allowed to restart because it DOES NOT own
     * the animation.
     * ======================================================== */

    LaunchedEffect(text) {

        if (text != committedText) {
            requests.trySend(text)
        }
    }


    /* ========================================================
     * SINGLE LONG-LIVED ANIMATION WORKER
     *
     * IMPORTANT:
     *
     * This effect has a constant key.
     *
     * Changing:
     *
     * - text
     * - committedText
     * - activePlan
     * - progress
     *
     * DOES NOT CANCEL THIS COROUTINE.
     * ======================================================== */

    LaunchedEffect(Unit) {

        for (requestedDestination in requests) {

            /*
             * Ignore stale/duplicate request.
             */
            if (
                requestedDestination ==
                committedText
            ) {
                continue
            }

            /*
             * Capture everything needed for THIS transition.
             */
            val source =
                committedText

            val destination =
                requestedDestination

            val spec =
                currentSpec

            val transitionMatcher =
                currentMatcher

            val plan =
                createTransitionPlan(
                    oldText =
                        source,
                    newText =
                        destination,
                    matcher =
                        transitionMatcher,
                )

            /*
             * Transition now exclusively owns rendering.
             */
            activeSpec =
                spec

            activePlan =
                plan

            if (
                spec.totalDurationMillis == 0
            ) {

                progress.snapTo(1f)

            } else {

                progress.snapTo(0f)

                /*
                 * Animatable.animateTo is suspend.
                 *
                 * Nothing below this runs until the animation
                 * reaches 1f.
                 */
                progress.animateTo(
                    targetValue =
                        1f,
                    animationSpec =
                        tween(
                            durationMillis =
                                spec.totalDurationMillis,
                            easing =
                                LinearEasing,
                        ),
                )
            }

            /*
             * COMMIT ONLY AFTER ALL THREE PHASES FINISH.
             */
            committedText =
                destination

            /*
             * Release transition renderer.
             */
            activePlan =
                null
        }
    }


    /* ========================================================
     * VISUAL SOURCE/TARGET
     * ======================================================== */

    val plan =
        activePlan

    /*
     * Incoming `text` is deliberately NOT used here.
     *
     * This is the important part that prevents the destination
     * from appearing early.
     */
    val visualOldText =
        plan?.oldText
            ?: committedText

    val visualNewText =
        plan?.newText
            ?: committedText


    /* ========================================================
     * GRAPHEMES
     * ======================================================== */

    val oldGraphemes =
        remember(visualOldText) {
            segmentGraphemes(
                visualOldText
            )
        }

    val newGraphemes =
        remember(visualNewText) {
            segmentGraphemes(
                visualNewText
            )
        }


    /* ========================================================
     * MEASUREMENT
     * ======================================================== */

    val oldWord =
        remember(
            visualOldText,
            style,
            textMeasurer,
        ) {
            measureWord(
                text =
                    visualOldText,
                graphemes =
                    oldGraphemes,
                textMeasurer =
                    textMeasurer,
                style =
                    style,
            )
        }

    val newWord =
        remember(
            visualNewText,
            style,
            textMeasurer,
        ) {
            measureWord(
                text =
                    visualNewText,
                graphemes =
                    newGraphemes,
                textMeasurer =
                    textMeasurer,
                style =
                    style,
            )
        }


    /* ========================================================
     * SIZE
     * ======================================================== */

    val widthPx =
        max(
            oldWord.width,
            newWord.width,
        )

    val heightPx =
        max(
            oldWord.height,
            newWord.height,
        )

    val density =
        LocalDensity.current

    val widthDp =
        with(density) {
            widthPx.toDp()
        }

    val heightDp =
        with(density) {
            heightPx.toDp()
        }


    /* ========================================================
     * CANVAS
     * ======================================================== */

    Canvas(
        modifier =
            modifier
                .requiredSize(
                    width =
                        widthDp,
                    height =
                        heightDp,
                )
                .semantics {

                    /*
                     * New value becomes authoritative only when
                     * the transition has completed.
                     */
                    this.text =
                        AnnotatedString(
                            committedText
                        )
                }
    ) {

        val transition =
            activePlan

        if (transition == null) {

            /*
             * STABLE STATE
             *
             * Draw exactly one complete word.
             */
            drawStableWord(
                oldWord
            )

        } else {

            /*
             * ANIMATED STATE
             *
             * drawTransition() owns ALL text rendering.
             *
             * No complete destination word is drawn.
             */
            val phase =
                calculatePhaseProgress(
                    progress =
                        progress.value,
                    spec =
                        activeSpec,
                )

            drawTransition(
                plan =
                    transition,
                oldWord =
                    oldWord,
                newWord =
                    newWord,
                phase =
                    phase,
                spec =
                    activeSpec,
            )
        }
    }
}


/* ============================================================
 * MODELS
 * ============================================================ */

@Immutable
data class Grapheme(
    val text: String,
    val startOffset: Int,
    val endOffset: Int,
)


@Immutable
data class Match(
    val oldIndex: Int,
    val newIndex: Int,
)


@Immutable
data class TransitionPlan(
    val oldText: String,
    val newText: String,
    val old: List<Grapheme>,
    val new: List<Grapheme>,
    val matches: List<Match>,
    val removedOldIndices: Set<Int>,
    val insertedNewIndices: Set<Int>,
)


/* ============================================================
 * SEGMENTATION
 * ============================================================ */

internal fun segmentGraphemes(
    text: String,
    locale: Locale =
        Locale.getDefault(),
): List<Grapheme> {

    if (text.isEmpty()) {
        return emptyList()
    }

    val iterator =
        BreakIterator
            .getCharacterInstance(
                locale
            )

    iterator.setText(text)

    val result =
        ArrayList<Grapheme>()

    var start =
        iterator.first()

    var end =
        iterator.next()

    while (
        end != BreakIterator.DONE
    ) {

        result +=
            Grapheme(
                text =
                    text.substring(
                        start,
                        end,
                    ),
                startOffset =
                    start,
                endOffset =
                    end,
            )

        start =
            end

        end =
            iterator.next()
    }

    return result
}


/* ============================================================
 * PLAN
 * ============================================================ */

internal fun createTransitionPlan(
    oldText: String,
    newText: String,
    matcher: MorphingTextMatcher =
        MinimumMovementMatcher,
): TransitionPlan {

    val old =
        segmentGraphemes(oldText)

    val new =
        segmentGraphemes(newText)

    val matches =
        matcher.match(
            old,
            new,
        )

    validateMatches(
        old,
        new,
        matches,
    )

    val matchedOld =
        matches.mapTo(
            HashSet()
        ) {
            it.oldIndex
        }

    val matchedNew =
        matches.mapTo(
            HashSet()
        ) {
            it.newIndex
        }

    val removed =
        old.indices
            .filterTo(
                LinkedHashSet()
            ) {
                it !in matchedOld
            }

    val inserted =
        new.indices
            .filterTo(
                LinkedHashSet()
            ) {
                it !in matchedNew
            }

    return TransitionPlan(
        oldText =
            oldText,
        newText =
            newText,
        old =
            old,
        new =
            new,
        matches =
            matches,
        removedOldIndices =
            removed,
        insertedNewIndices =
            inserted,
    )
}


private fun validateMatches(
    old: List<Grapheme>,
    new: List<Grapheme>,
    matches: List<Match>,
) {

    var previousOld =
        -1

    var previousNew =
        -1

    val seenOld =
        HashSet<Int>()

    val seenNew =
        HashSet<Int>()

    matches.forEach { match ->

        require(
            match.oldIndex in old.indices
        )

        require(
            match.newIndex in new.indices
        )

        require(
            seenOld.add(
                match.oldIndex
            )
        )

        require(
            seenNew.add(
                match.newIndex
            )
        )

        require(
            old[match.oldIndex].text ==
                new[match.newIndex].text
        )

        require(
            match.oldIndex >
                previousOld
        )

        require(
            match.newIndex >
                previousNew
        )

        previousOld =
            match.oldIndex

        previousNew =
            match.newIndex
    }
}


/* ============================================================
 * PHASE CALCULATION
 * ============================================================ */

@Immutable
internal data class PhaseProgress(
    val exit: Float,
    val move: Float,
    val enter: Float,
)


internal fun calculatePhaseProgress(
    progress: Float,
    spec: MorphingTextAnimationSpec,
): PhaseProgress {

    val total =
        spec.totalDurationMillis

    if (total == 0) {
        return PhaseProgress(
            exit = 1f,
            move = 1f,
            enter = 1f,
        )
    }

    val time =
        progress
            .coerceIn(0f, 1f) *
            total

    val moveStart =
        spec.exitDurationMillis
            .toFloat()

    val enterStart =
        (
            spec.exitDurationMillis +
                spec.moveDurationMillis
        ).toFloat()

    return PhaseProgress(
        exit =
            phaseFraction(
                time,
                0f,
                spec.exitDurationMillis,
            ),

        move =
            phaseFraction(
                time,
                moveStart,
                spec.moveDurationMillis,
            ),

        enter =
            phaseFraction(
                time,
                enterStart,
                spec.enterDurationMillis,
            ),
    )
}


private fun phaseFraction(
    time: Float,
    start: Float,
    duration: Int,
): Float {

    if (duration == 0) {
        return if (
            time >= start
        ) 1f else 0f
    }

    return (
        (time - start) /
            duration
    ).coerceIn(
        0f,
        1f,
    )
}


/* ============================================================
 * MEASUREMENT
 * ============================================================ */

@Immutable
internal data class MeasuredGrapheme(
    val grapheme: Grapheme,
    val x: Float,
    val isolatedLayout: TextLayoutResult,
)


@Immutable
internal data class MeasuredWord(
    val fullLayout: TextLayoutResult?,
    val graphemes: List<MeasuredGrapheme>,
    val width: Float,
    val height: Float,
)


private fun measureWord(
    text: String,
    graphemes: List<Grapheme>,
    textMeasurer: TextMeasurer,
    style: TextStyle,
): MeasuredWord {

    if (text.isEmpty()) {

        val probe =
            textMeasurer.measure(
                text =
                    AnnotatedString("Mg"),
                style =
                    style,
                softWrap =
                    false,
                maxLines =
                    1,
                constraints =
                    Constraints(),
            )

        return MeasuredWord(
            fullLayout =
                null,
            graphemes =
                emptyList(),
            width =
                0f,
            height =
                probe.size.height.toFloat(),
        )
    }

    val full =
        textMeasurer.measure(
            text =
                AnnotatedString(text),
            style =
                style,
            softWrap =
                false,
            maxLines =
                1,
            constraints =
                Constraints(),
        )

    val measured =
        graphemes.map { grapheme ->

            val box =
                full.getBoundingBox(
                    grapheme.startOffset
                )

            val isolated =
                textMeasurer.measure(
                    text =
                        AnnotatedString(
                            grapheme.text
                        ),
                    style =
                        style,
                    softWrap =
                        false,
                    maxLines =
                        1,
                    constraints =
                        Constraints(),
                )

            MeasuredGrapheme(
                grapheme =
                    grapheme,
                x =
                    box.left,
                isolatedLayout =
                    isolated,
            )
        }

    return MeasuredWord(
        fullLayout =
            full,
        graphemes =
            measured,
        width =
            full.size.width.toFloat(),
        height =
            full.size.height.toFloat(),
    )
}


/* ============================================================
 * RENDERING
 * ============================================================ */

private fun DrawScope.drawStableWord(
    word: MeasuredWord,
) {

    word.fullLayout?.let {

        drawText(
            textLayoutResult =
                it,
            topLeft =
                Offset.Zero,
        )
    }
}


private fun DrawScope.drawTransition(
    plan: TransitionPlan,
    oldWord: MeasuredWord,
    newWord: MeasuredWord,
    phase: PhaseProgress,
    spec: MorphingTextAnimationSpec,
) {

    val exit =
        spec.fadeEasing
            .transform(
                phase.exit
            )
            .coerceIn(0f, 1f)

    val move =
        spec.moveEasing
            .transform(
                phase.move
            )
            .coerceIn(0f, 1f)

    val enter =
        spec.fadeEasing
            .transform(
                phase.enter
            )
            .coerceIn(0f, 1f)


    val matchByOld =
        plan.matches
            .associateBy {
                it.oldIndex
            }

    val matchedNew =
        plan.matches
            .mapTo(
                HashSet()
            ) {
                it.newIndex
            }


    /* --------------------------------------------------------
     * OLD OBJECTS
     * -------------------------------------------------------- */

    oldWord.graphemes
        .forEachIndexed {
                oldIndex,
                oldGrapheme ->

            val match =
                matchByOld[
                    oldIndex
                ]

            if (match == null) {

                /*
                 * REMOVE:
                 *
                 * position frozen.
                 */
                drawGrapheme(
                    grapheme =
                        oldGrapheme,
                    x =
                        oldGrapheme.x,
                    alpha =
                        1f - exit,
                )

            } else {

                /*
                 * SURVIVOR:
                 *
                 * same object throughout the entire transition.
                 */
                val destination =
                    newWord.graphemes[
                        match.newIndex
                    ]

                drawGrapheme(
                    grapheme =
                        oldGrapheme,

                    x =
                        lerp(
                            oldGrapheme.x,
                            destination.x,
                            move,
                        ),

                    alpha =
                        1f,
                )
            }
        }


    /* --------------------------------------------------------
     * NEW-ONLY OBJECTS
     *
     * Matched destination objects are NOT drawn.
     * -------------------------------------------------------- */

    newWord.graphemes
        .forEachIndexed {
                newIndex,
                newGrapheme ->

            if (
                newIndex in matchedNew
            ) {
                return@forEachIndexed
            }

            drawGrapheme(
                grapheme =
                    newGrapheme,
                x =
                    newGrapheme.x,
                alpha =
                    enter,
            )
        }
}


private fun DrawScope.drawGrapheme(
    grapheme: MeasuredGrapheme,
    x: Float,
    alpha: Float,
) {

    if (alpha <= 0f) {
        return
    }

    drawText(
        textLayoutResult =
            grapheme.isolatedLayout,

        topLeft =
            Offset(
                x = x,
                y = 0f,
            ),

        alpha =
            alpha.coerceIn(
                0f,
                1f,
            ),
    )
}


private fun lerp(
    start: Float,
    end: Float,
    fraction: Float,
): Float {

    val f =
        fraction.coerceIn(
            0f,
            1f,
        )

    return start +
        (end - start) * f
}
