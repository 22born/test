/* ============================================================
 * ANIMATION SPEC
 *
 * CHANGE YOUR DEFAULTS HERE.
 *
 * These durations are the ACTUAL fade/movement durations.
 * ============================================================ */

@Immutable
data class MorphingTextAnimationSpec(
    val exitDurationMillis: Int = 100,
    val moveDurationMillis: Int = 200,
    val enterDurationMillis: Int = 100,
) {

    init {
        require(exitDurationMillis >= 0) {
            "exitDurationMillis must be >= 0"
        }

        require(moveDurationMillis >= 0) {
            "moveDurationMillis must be >= 0"
        }

        require(enterDurationMillis >= 0) {
            "enterDurationMillis must be >= 0"
        }
    }

    val moveStartMillis: Int
        get() =
            exitDurationMillis

    val enterStartMillis: Int
        get() =
            exitDurationMillis +
                moveDurationMillis

    val totalDurationMillis: Int
        get() =
            exitDurationMillis +
                moveDurationMillis +
                enterDurationMillis
}


/* ============================================================
 * PUBLIC MODELS
 * ============================================================ */

@Immutable
data class Grapheme(
    val text: String,
    val startOffset: Int,
    val endOffset: Int,
)


@Immutable
data class Match(
    val oldIndex: Int,
    val newIndex: Int,
)


fun interface MorphingTextMatcher {

    fun match(
        old: List<Grapheme>,
        new: List<Grapheme>,
    ): List<Match>
}


/* ============================================================
 * MATCHER
 *
 * Deterministic priority:
 *
 * 1. Reuse maximum number of graphemes.
 * 2. Minimize total index movement.
 * 3. Preserve ordering.
 * 4. Lexicographic tie-break.
 * ============================================================ */

object MinimumMovementMatcher : MorphingTextMatcher {

    private data class Candidate(
        val matches: List<Match>,
        val movementCost: Int,
    )

    override fun match(
        old: List<Grapheme>,
        new: List<Grapheme>,
    ): List<Match> {

        if (
            old.isEmpty() ||
            new.isEmpty()
        ) {
            return emptyList()
        }

        val memo =
            HashMap<Pair<Int, Int>, Candidate>()

        fun compareMatches(
            first: List<Match>,
            second: List<Match>,
        ): Int {

            val size =
                minOf(
                    first.size,
                    second.size,
                )

            for (index in 0 until size) {

                val a =
                    first[index]

                val b =
                    second[index]

                if (
                    a.oldIndex !=
                    b.oldIndex
                ) {
                    return a.oldIndex
                        .compareTo(
                            b.oldIndex
                        )
                }

                if (
                    a.newIndex !=
                    b.newIndex
                ) {
                    return a.newIndex
                        .compareTo(
                            b.newIndex
                        )
                }
            }

            return first.size
                .compareTo(
                    second.size
                )
        }

        fun better(
            first: Candidate,
            second: Candidate,
        ): Candidate {

            /*
             * Reuse as many as possible.
             */
            if (
                first.matches.size !=
                second.matches.size
            ) {
                return if (
                    first.matches.size >
                    second.matches.size
                ) {
                    first
                } else {
                    second
                }
            }

            /*
             * Then minimize movement.
             */
            if (
                first.movementCost !=
                second.movementCost
            ) {
                return if (
                    first.movementCost <
                    second.movementCost
                ) {
                    first
                } else {
                    second
                }
            }

            /*
             * Final deterministic tie-break.
             */
            return if (
                compareMatches(
                    first.matches,
                    second.matches,
                ) <= 0
            ) {
                first
            } else {
                second
            }
        }

        fun solve(
            oldIndex: Int,
            newIndex: Int,
        ): Candidate {

            if (
                oldIndex >= old.size ||
                newIndex >= new.size
            ) {
                return Candidate(
                    matches =
                        emptyList(),
                    movementCost =
                        0,
                )
            }

            val key =
                oldIndex to newIndex

            memo[key]?.let {
                return it
            }

            /*
             * Option 1:
             * remove old grapheme.
             */
            var best =
                solve(
                    oldIndex + 1,
                    newIndex,
                )

            /*
             * Option 2:
             * insert new grapheme.
             */
            best =
                better(
                    best,
                    solve(
                        oldIndex,
                        newIndex + 1,
                    ),
                )

            /*
             * Option 3:
             * reuse.
             */
            if (
                old[oldIndex].text ==
                new[newIndex].text
            ) {

                val suffix =
                    solve(
                        oldIndex + 1,
                        newIndex + 1,
                    )

                val candidate =
                    Candidate(
                        matches =
                            listOf(
                                Match(
                                    oldIndex =
                                        oldIndex,
                                    newIndex =
                                        newIndex,
                                )
                            ) +
                                suffix.matches,

                        movementCost =
                            abs(
                                oldIndex -
                                    newIndex
                            ) +
                                suffix.movementCost,
                    )

                best =
                    better(
                        best,
                        candidate,
                    )
            }

            memo[key] =
                best

            return best
        }

        return solve(
            oldIndex = 0,
            newIndex = 0,
        ).matches
    }
}


/* ============================================================
 * TRANSITION PLAN
 * ============================================================ */

@Immutable
data class TransitionPlan(
    val oldText: String,
    val newText: String,
    val old: List<Grapheme>,
    val new: List<Grapheme>,
    val matches: List<Match>,
    val removedOldIndices: Set<Int>,
    val insertedNewIndices: Set<Int>,
)


/*
 * Spec is frozen for the lifetime of this transition.
 */
@Immutable
private data class ActiveTransition(
    val plan: TransitionPlan,
    val spec: MorphingTextAnimationSpec,
)


/* ============================================================
 * COMPOSABLE
 * ============================================================ */

@Composable
fun MorphingText(
    text: String,
    modifier: Modifier = Modifier,
    style: TextStyle = LocalTextStyle.current,
    animationSpec: MorphingTextAnimationSpec =
        MorphingTextAnimationSpec(),
    matcher: MorphingTextMatcher =
        MinimumMovementMatcher,
) {

    val textMeasurer =
        rememberTextMeasurer(
            cacheSize = 64
        )


    /* --------------------------------------------------------
     * COMMITTED TEXT
     *
     * Changes only after the complete animation finishes.
     * -------------------------------------------------------- */

    var committedText by remember {
        mutableStateOf(text)
    }


    /* --------------------------------------------------------
     * ACTIVE TRANSITION
     *
     * null = stable.
     * -------------------------------------------------------- */

    var activeTransition by remember {
        mutableStateOf<ActiveTransition?>(null)
    }


    /* --------------------------------------------------------
     * ELAPSED ANIMATION TIME
     *
     * This is the important change.
     *
     * We animate:
     *
     * 0ms -> totalDurationMillis
     *
     * linearly.
     * -------------------------------------------------------- */

    val elapsedMillis =
        remember {
            Animatable(0f)
        }


    /* --------------------------------------------------------
     * REQUEST QUEUE
     *
     * Conflated:
     * while animation runs, only latest target is retained.
     * -------------------------------------------------------- */

    val requests =
        remember {
            Channel<String>(
                capacity =
                    Channel.CONFLATED
            )
        }


    /*
     * Allow worker to obtain latest configuration without
     * restarting/cancelling itself.
     */
    val latestSpec by
        rememberUpdatedState(
            animationSpec
        )

    val latestMatcher by
        rememberUpdatedState(
            matcher
        )


    /* ========================================================
     * PRODUCER
     * ======================================================== */

    LaunchedEffect(text) {

        if (
            text != committedText
        ) {
            requests.trySend(
                text
            )
        }
    }


    /* ========================================================
     * SINGLE LONG-LIVED WORKER
     * ======================================================== */

    LaunchedEffect(Unit) {

        for (
            destination in requests
        ) {

            /*
             * Ignore stale request.
             */
            if (
                destination ==
                committedText
            ) {
                continue
            }


            /*
             * Freeze all configuration for this transition.
             */
            val spec =
                latestSpec

            val matcherForTransition =
                latestMatcher


            val plan =
                createTransitionPlan(
                    oldText =
                        committedText,
                    newText =
                        destination,
                    matcher =
                        matcherForTransition,
                )


            activeTransition =
                ActiveTransition(
                    plan =
                        plan,
                    spec =
                        spec,
                )


            /*
             * Start at EXACTLY zero elapsed milliseconds.
             */
            elapsedMillis.snapTo(
                0f
            )


            /*
             * Animate elapsed time continuously.
             *
             * LinearEasing is deliberate:
             *
             * 500ms into a 1000ms phase = exactly 50%.
             */
            if (
                spec.totalDurationMillis > 0
            ) {

                elapsedMillis.animateTo(
                    targetValue =
                        spec
                            .totalDurationMillis
                            .toFloat(),

                    animationSpec =
                        tween(
                            durationMillis =
                                spec.totalDurationMillis,
                            easing =
                                LinearEasing,
                        ),
                )

            } else {

                elapsedMillis.snapTo(
                    0f
                )
            }


            /*
             * IMPORTANT:
             *
             * animateTo() suspends until the timeline completes.
             *
             * Only now does destination become committed.
             */
            committedText =
                destination

            activeTransition =
                null
        }
    }


    /* ========================================================
     * VISUAL TEXT
     * ======================================================== */

    val transition =
        activeTransition

    val visualOldText =
        transition
            ?.plan
            ?.oldText
            ?: committedText

    val visualNewText =
        transition
            ?.plan
            ?.newText
            ?: committedText


    /* ========================================================
     * GRAPHEMES
     * ======================================================== */

    val oldGraphemes =
        remember(
            visualOldText
        ) {
            segmentGraphemes(
                visualOldText
            )
        }

    val newGraphemes =
        remember(
            visualNewText
        ) {
            segmentGraphemes(
                visualNewText
            )
        }


    /* ========================================================
     * MEASURE
     * ======================================================== */

    val oldWord =
        remember(
            visualOldText,
            style,
            textMeasurer,
        ) {
            measureWord(
                text =
                    visualOldText,
                graphemes =
                    oldGraphemes,
                textMeasurer =
                    textMeasurer,
                style =
                    style,
            )
        }

    val newWord =
        remember(
            visualNewText,
            style,
            textMeasurer,
        ) {
            measureWord(
                text =
                    visualNewText,
                graphemes =
                    newGraphemes,
                textMeasurer =
                    textMeasurer,
                style =
                    style,
            )
        }


    /* ========================================================
     * SIZE
     * ======================================================== */

    val widthPx =
        max(
            oldWord.width,
            newWord.width,
        )

    val heightPx =
        max(
            oldWord.height,
            newWord.height,
        )

    val density =
        LocalDensity.current

    val widthDp =
        with(density) {
            widthPx.toDp()
        }

    val heightDp =
        with(density) {
            heightPx.toDp()
        }


    /* ========================================================
     * FRAME
     *
     * Read elapsedMillis as Compose state.
     * ======================================================== */

    val currentElapsedMillis =
        elapsedMillis.value

    val frame =
        transition?.let {

            calculateFrameProgress(
                elapsedMillis =
                    currentElapsedMillis,
                spec =
                    it.spec,
            )
        }


    /* ========================================================
     * CANVAS
     * ======================================================== */

    Canvas(
        modifier =
            modifier
                .requiredSize(
                    width =
                        widthDp,
                    height =
                        heightDp,
                )
                .semantics {

                    /*
                     * Accessibility exposes committed text.
                     *
                     * Destination is exposed only after animation.
                     */
                    this.text =
                        AnnotatedString(
                            committedText
                        )
                }
    ) {

        val currentTransition =
            transition

        val currentFrame =
            frame

        if (
            currentTransition == null ||
            currentFrame == null
        ) {

            /*
             * Stable state.
             */
            drawStableWord(
                word =
                    oldWord
            )

            return@Canvas
        }


        /*
         * During transition this renderer exclusively owns text.
         *
         * The complete destination word is NOT drawn separately.
         */
        drawTransition(
            plan =
                currentTransition.plan,
            oldWord =
                oldWord,
            newWord =
                newWord,
            frame =
                currentFrame,
        )
    }
}


/* ============================================================
 * PURE TIMELINE CALCULATION
 * ============================================================ */

@Immutable
internal data class FrameProgress(
    val exit: Float,
    val move: Float,
    val enter: Float,
)


/**
 * Pure deterministic function.
 *
 * Example:
 *
 * exit  = 1000ms
 * move  = 500ms
 * enter = 1000ms
 *
 * elapsed = 500ms
 *
 * exit  = .5
 * move  = 0
 * enter = 0
 */
internal fun calculateFrameProgress(
    elapsedMillis: Float,
    spec: MorphingTextAnimationSpec,
): FrameProgress {

    val elapsed =
        elapsedMillis.coerceIn(
            minimumValue =
                0f,
            maximumValue =
                spec
                    .totalDurationMillis
                    .toFloat(),
        )

    return FrameProgress(
        exit =
            calculateFraction(
                elapsedMillis =
                    elapsed,
                startMillis =
                    0,
                durationMillis =
                    spec.exitDurationMillis,
            ),

        move =
            calculateFraction(
                elapsedMillis =
                    elapsed,
                startMillis =
                    spec.moveStartMillis,
                durationMillis =
                    spec.moveDurationMillis,
            ),

        enter =
            calculateFraction(
                elapsedMillis =
                    elapsed,
                startMillis =
                    spec.enterStartMillis,
                durationMillis =
                    spec.enterDurationMillis,
            ),
    )
}


private fun calculateFraction(
    elapsedMillis: Float,
    startMillis: Int,
    durationMillis: Int,
): Float {

    /*
     * Zero-duration phase completes instantly once its start
     * time has been reached.
     */
    if (
        durationMillis == 0
    ) {

        return if (
            elapsedMillis >=
            startMillis.toFloat()
        ) {
            1f
        } else {
            0f
        }
    }


    return (
        (
            elapsedMillis -
                startMillis.toFloat()
            ) /
            durationMillis.toFloat()
        )
        .coerceIn(
            minimumValue =
                0f,
            maximumValue =
                1f,
        )
}


/* ============================================================
 * GRAPHEME SEGMENTATION
 * ============================================================ */

internal fun segmentGraphemes(
    text: String,
    locale: Locale =
        Locale.getDefault(),
): List<Grapheme> {

    if (
        text.isEmpty()
    ) {
        return emptyList()
    }


    val iterator =
        BreakIterator
            .getCharacterInstance(
                locale
            )

    iterator.setText(
        text
    )


    val result =
        ArrayList<Grapheme>()


    var start =
        iterator.first()

    var end =
        iterator.next()


    while (
        end !=
        BreakIterator.DONE
    ) {

        result +=
            Grapheme(
                text =
                    text.substring(
                        start,
                        end,
                    ),
                startOffset =
                    start,
                endOffset =
                    end,
            )

        start =
            end

        end =
            iterator.next()
    }


    return result
}


/* ============================================================
 * CREATE TRANSITION PLAN
 * ============================================================ */

internal fun createTransitionPlan(
    oldText: String,
    newText: String,
    matcher: MorphingTextMatcher =
        MinimumMovementMatcher,
): TransitionPlan {

    val old =
        segmentGraphemes(
            oldText
        )

    val new =
        segmentGraphemes(
            newText
        )


    val matches =
        matcher.match(
            old =
                old,
            new =
                new,
        )


    validateMatches(
        old =
            old,
        new =
            new,
        matches =
            matches,
    )


    val matchedOld =
        matches.mapTo(
            HashSet()
        ) {
            it.oldIndex
        }

    val matchedNew =
        matches.mapTo(
            HashSet()
        ) {
            it.newIndex
        }


    val removed =
        old.indices
            .filterTo(
                LinkedHashSet()
            ) {
                it !in matchedOld
            }


    val inserted =
        new.indices
            .filterTo(
                LinkedHashSet()
            ) {
                it !in matchedNew
            }


    return TransitionPlan(
        oldText =
            oldText,
        newText =
            newText,
        old =
            old,
        new =
            new,
        matches =
            matches,
        removedOldIndices =
            removed,
        insertedNewIndices =
            inserted,
    )
}


/* ============================================================
 * VALIDATE MATCHES
 * ============================================================ */

private fun validateMatches(
    old: List<Grapheme>,
    new: List<Grapheme>,
    matches: List<Match>,
) {

    var previousOld =
        -1

    var previousNew =
        -1


    val seenOld =
        HashSet<Int>()

    val seenNew =
        HashSet<Int>()


    for (
        match in matches
    ) {

        require(
            match.oldIndex in
                old.indices
        ) {
            "Invalid oldIndex=${match.oldIndex}"
        }

        require(
            match.newIndex in
                new.indices
        ) {
            "Invalid newIndex=${match.newIndex}"
        }


        require(
            seenOld.add(
                match.oldIndex
            )
        ) {
            "oldIndex=${match.oldIndex} matched multiple times"
        }


        require(
            seenNew.add(
                match.newIndex
            )
        ) {
            "newIndex=${match.newIndex} matched multiple times"
        }


        require(
            old[
                match.oldIndex
            ].text ==
                new[
                    match.newIndex
                ].text
        ) {
            "Matcher matched different graphemes"
        }


        require(
            match.oldIndex >
                previousOld
        ) {
            "Old match indices must be increasing"
        }


        require(
            match.newIndex >
                previousNew
        ) {
            "New match indices must be increasing"
        }


        previousOld =
            match.oldIndex

        previousNew =
            match.newIndex
    }
}


/* ============================================================
 * MEASUREMENT
 * ============================================================ */

private data class MeasuredGrapheme(
    val grapheme: Grapheme,
    val x: Float,
    val layout: TextLayoutResult,
)


private data class MeasuredWord(
    val fullLayout: TextLayoutResult?,
    val graphemes: List<MeasuredGrapheme>,
    val width: Float,
    val height: Float,
)


private fun measureWord(
    text: String,
    graphemes: List<Grapheme>,
    textMeasurer: TextMeasurer,
    style: TextStyle,
): MeasuredWord {

    /*
     * Empty text still needs line height.
     */
    if (
        text.isEmpty()
    ) {

        val probe =
            textMeasurer.measure(
                text =
                    AnnotatedString(
                        "Mg"
                    ),
                style =
                    style,
                softWrap =
                    false,
                maxLines =
                    1,
                constraints =
                    Constraints(),
            )


        return MeasuredWord(
            fullLayout =
                null,
            graphemes =
                emptyList(),
            width =
                0f,
            height =
                probe
                    .size
                    .height
                    .toFloat(),
        )
    }


    /*
     * Complete word determines actual positions.
     */
    val fullLayout =
        textMeasurer.measure(
            text =
                AnnotatedString(
                    text
                ),
            style =
                style,
            softWrap =
                false,
            maxLines =
                1,
            constraints =
                Constraints(),
        )


    val measured =
        graphemes.map {
                grapheme ->

            /*
             * Position in complete text layout.
             *
             * Supported rendering contract is single-line
             * LTR/simple-script text.
             */
            val boundingBox =
                fullLayout.getBoundingBox(
                    grapheme.startOffset
                )


            /*
             * Isolated layout used for independent animation.
             */
            val isolated =
                textMeasurer.measure(
                    text =
                        AnnotatedString(
                            grapheme.text
                        ),
                    style =
                        style,
                    softWrap =
                        false,
                    maxLines =
                        1,
                    constraints =
                        Constraints(),
                )


            MeasuredGrapheme(
                grapheme =
                    grapheme,
                x =
                    boundingBox.left,
                layout =
                    isolated,
            )
        }


    return MeasuredWord(
        fullLayout =
            fullLayout,
        graphemes =
            measured,
        width =
            fullLayout
                .size
                .width
                .toFloat(),
        height =
            fullLayout
                .size
                .height
                .toFloat(),
    )
}


/* ============================================================
 * DRAW STABLE
 * ============================================================ */

private fun DrawScope.drawStableWord(
    word: MeasuredWord,
) {

    val layout =
        word.fullLayout
            ?: return


    drawText(
        textLayoutResult =
            layout,
        topLeft =
            Offset.Zero,
    )
}


/* ============================================================
 * DRAW TRANSITION
 * ============================================================ */

private fun DrawScope.drawTransition(
    plan: TransitionPlan,
    oldWord: MeasuredWord,
    newWord: MeasuredWord,
    frame: FrameProgress,
) {

    val matchByOldIndex =
        plan.matches
            .associateBy {
                it.oldIndex
            }


    val matchedNewIndices =
        plan.matches
            .mapTo(
                HashSet()
            ) {
                it.newIndex
            }


    /* --------------------------------------------------------
     * OLD OBJECTS
     * -------------------------------------------------------- */

    oldWord.graphemes
        .forEachIndexed {
                oldIndex,
                oldGrapheme ->

            val match =
                matchByOldIndex[
                    oldIndex
                ]


            if (
                match == null
            ) {

                /*
                 * REMOVE
                 *
                 * Position remains fixed.
                 *
                 * frame.exit:
                 *
                 * 0 -> alpha 1
                 * .5 -> alpha .5
                 * 1 -> alpha 0
                 */
                drawGrapheme(
                    grapheme =
                        oldGrapheme,
                    x =
                        oldGrapheme.x,
                    alpha =
                        1f -
                            frame.exit,
                )

            } else {

                /*
                 * SURVIVOR
                 *
                 * The OLD object remains the rendered object.
                 *
                 * We never draw its matched NEW object.
                 */
                val destination =
                    newWord.graphemes[
                        match.newIndex
                    ]


                val x =
                    lerp(
                        start =
                            oldGrapheme.x,
                        end =
                            destination.x,
                        fraction =
                            frame.move,
                    )


                drawGrapheme(
                    grapheme =
                        oldGrapheme,
                    x =
                        x,
                    alpha =
                        1f,
                )
            }
        }


    /* --------------------------------------------------------
     * NEW-ONLY OBJECTS
     * -------------------------------------------------------- */

    newWord.graphemes
        .forEachIndexed {
                newIndex,
                newGrapheme ->

            /*
             * Critical:
             *
             * Do NOT draw destination copy of a survivor.
             */
            if (
                newIndex in
                matchedNewIndices
            ) {
                return@forEachIndexed
            }


            /*
             * INSERT
             *
             * Always stays at final X.
             *
             * frame.enter:
             *
             * 0 -> alpha 0
             * .5 -> alpha .5
             * 1 -> alpha 1
             */
            drawGrapheme(
                grapheme =
                    newGrapheme,
                x =
                    newGrapheme.x,
                alpha =
                    frame.enter,
            )
        }
}


/* ============================================================
 * DRAW GRAPHEME
 * ============================================================ */

private fun DrawScope.drawGrapheme(
    grapheme: MeasuredGrapheme,
    x: Float,
    alpha: Float,
) {

    val safeAlpha =
        alpha.coerceIn(
            minimumValue =
                0f,
            maximumValue =
                1f,
        )


    if (
        safeAlpha <= 0f
    ) {
        return
    }


    drawText(
        textLayoutResult =
            grapheme.layout,
        topLeft =
            Offset(
                x =
                    x,
                y =
                    0f,
            ),
        alpha =
            safeAlpha,
    )
}


/* ============================================================
 * LINEAR INTERPOLATION
 * ============================================================ */

private fun lerp(
    start: Float,
    end: Float,
    fraction: Float,
): Float {

    val p =
        fraction.coerceIn(
            minimumValue =
                0f,
            maximumValue =
                1f,
        )


    return start +
        (
            end -
                start
        ) * p
}
