/* ============================================================
 * CHANGE DEFAULT DURATIONS HERE
 * ============================================================ */

@Immutable
data class MorphingTextAnimationSpec(
    val exitDurationMillis: Int = 100,
    val moveDurationMillis: Int = 200,
    val enterDurationMillis: Int = 100,
) {
    init {
        require(exitDurationMillis >= 0)
        require(moveDurationMillis >= 0)
        require(enterDurationMillis >= 0)
    }

    val totalDurationMillis: Int
        get() =
            exitDurationMillis +
                moveDurationMillis +
                enterDurationMillis
}


/* ============================================================
 * PUBLIC MODELS
 * ============================================================ */

enum class MorphPhase {
    Remove,
    Move,
    Insert,
}


@Immutable
data class Grapheme(
    val text: String,
    val startOffset: Int,
    val endOffset: Int,
)


@Immutable
data class Match(
    val oldIndex: Int,
    val newIndex: Int,
)


fun interface MorphingTextMatcher {

    fun match(
        old: List<Grapheme>,
        new: List<Grapheme>,
    ): List<Match>
}


/* ============================================================
 * MATCHER
 * ============================================================ */

object MinimumMovementMatcher : MorphingTextMatcher {

    private data class Candidate(
        val matches: List<Match>,
        val movementCost: Int,
    )

    override fun match(
        old: List<Grapheme>,
        new: List<Grapheme>,
    ): List<Match> {

        if (old.isEmpty() || new.isEmpty()) {
            return emptyList()
        }

        val memo =
            HashMap<Pair<Int, Int>, Candidate>()

        fun lexicographicCompare(
            a: List<Match>,
            b: List<Match>,
        ): Int {

            val count =
                minOf(a.size, b.size)

            for (i in 0 until count) {

                val am = a[i]
                val bm = b[i]

                if (am.oldIndex != bm.oldIndex) {
                    return am.oldIndex.compareTo(
                        bm.oldIndex
                    )
                }

                if (am.newIndex != bm.newIndex) {
                    return am.newIndex.compareTo(
                        bm.newIndex
                    )
                }
            }

            return a.size.compareTo(b.size)
        }

        fun better(
            a: Candidate,
            b: Candidate,
        ): Candidate {

            // First: reuse maximum number of graphemes.
            if (a.matches.size != b.matches.size) {
                return if (
                    a.matches.size > b.matches.size
                ) a else b
            }

            // Second: minimum movement.
            if (a.movementCost != b.movementCost) {
                return if (
                    a.movementCost < b.movementCost
                ) a else b
            }

            // Third: deterministic tie-break.
            return if (
                lexicographicCompare(
                    a.matches,
                    b.matches,
                ) <= 0
            ) {
                a
            } else {
                b
            }
        }

        fun solve(
            oldIndex: Int,
            newIndex: Int,
        ): Candidate {

            if (
                oldIndex >= old.size ||
                newIndex >= new.size
            ) {
                return Candidate(
                    matches = emptyList(),
                    movementCost = 0,
                )
            }

            val key =
                oldIndex to newIndex

            memo[key]?.let {
                return it
            }

            // Remove old.
            var best =
                solve(
                    oldIndex + 1,
                    newIndex,
                )

            // Insert new.
            best =
                better(
                    best,
                    solve(
                        oldIndex,
                        newIndex + 1,
                    ),
                )

            // Match/reuse.
            if (
                old[oldIndex].text ==
                new[newIndex].text
            ) {

                val suffix =
                    solve(
                        oldIndex + 1,
                        newIndex + 1,
                    )

                val candidate =
                    Candidate(
                        matches =
                            listOf(
                                Match(
                                    oldIndex,
                                    newIndex,
                                )
                            ) + suffix.matches,

                        movementCost =
                            abs(
                                oldIndex -
                                    newIndex
                            ) +
                                suffix.movementCost,
                    )

                best =
                    better(
                        best,
                        candidate,
                    )
            }

            memo[key] = best

            return best
        }

        return solve(0, 0).matches
    }
}


/* ============================================================
 * TRANSITION
 * ============================================================ */

@Immutable
data class TransitionPlan(
    val oldText: String,
    val newText: String,
    val old: List<Grapheme>,
    val new: List<Grapheme>,
    val matches: List<Match>,
    val removedOldIndices: Set<Int>,
    val insertedNewIndices: Set<Int>,
)


/*
 * IMPORTANT:
 *
 * The spec belongs to the active transition.
 *
 * If MorphingText recomposes while the transition is running,
 * its timing cannot accidentally change underneath it.
 */
@Immutable
private data class ActiveTransition(
    val plan: TransitionPlan,
    val spec: MorphingTextAnimationSpec,
)


/* ============================================================
 * COMPOSABLE
 * ============================================================ */

@Composable
fun MorphingText(
    text: String,
    modifier: Modifier = Modifier,
    style: TextStyle = LocalTextStyle.current,
    animationSpec: MorphingTextAnimationSpec =
        MorphingTextAnimationSpec(),
    matcher: MorphingTextMatcher =
        MinimumMovementMatcher,
) {

    val textMeasurer =
        rememberTextMeasurer(
            cacheSize = 64
        )

    /*
     * Only changes after REMOVE + MOVE + INSERT all finish.
     */
    var committedText by remember {
        mutableStateOf(text)
    }

    /*
     * null = idle.
     */
    var activeTransition by remember {
        mutableStateOf<ActiveTransition?>(null)
    }

    /*
     * Current animation phase.
     */
    var activePhase by remember {
        mutableStateOf<MorphPhase?>(null)
    }

    /*
     * 0 -> 1 for EACH individual phase.
     */
    val phaseProgress =
        remember {
            Animatable(0f)
        }

    /*
     * While an animation is running, only keep the newest
     * requested destination.
     */
    val requests =
        remember {
            Channel<String>(
                capacity =
                    Channel.CONFLATED
            )
        }

    /*
     * Gives the long-lived worker the latest values without
     * restarting/cancelling that worker.
     */
    val latestSpec by
        rememberUpdatedState(
            animationSpec
        )

    val latestMatcher by
        rememberUpdatedState(
            matcher
        )


    /* ========================================================
     * SEND TARGET CHANGES TO WORKER
     * ======================================================== */

    LaunchedEffect(text) {

        if (text != committedText) {
            requests.trySend(text)
        }
    }


    /* ========================================================
     * ONE LONG-LIVED ANIMATION WORKER
     * ======================================================== */

    LaunchedEffect(Unit) {

        for (destination in requests) {

            if (
                destination ==
                committedText
            ) {
                continue
            }

            /*
             * Freeze configuration NOW.
             *
             * Changing defaults/spec during this transition
             * affects the NEXT transition, not this one.
             */
            val spec =
                latestSpec

            val matcherForTransition =
                latestMatcher

            val plan =
                createTransitionPlan(
                    oldText =
                        committedText,
                    newText =
                        destination,
                    matcher =
                        matcherForTransition,
                )

            activeTransition =
                ActiveTransition(
                    plan =
                        plan,
                    spec =
                        spec,
                )


            /* ===============================================
             * REMOVE
             *
             * Uses exitDurationMillis DIRECTLY.
             * =============================================== */

            activePhase =
                MorphPhase.Remove

            runPhase(
                progress =
                    phaseProgress,
                durationMillis =
                    spec.exitDurationMillis,
            )


            /* ===============================================
             * MOVE
             *
             * Uses moveDurationMillis DIRECTLY.
             * =============================================== */

            activePhase =
                MorphPhase.Move

            runPhase(
                progress =
                    phaseProgress,
                durationMillis =
                    spec.moveDurationMillis,
            )


            /* ===============================================
             * INSERT
             *
             * Uses enterDurationMillis DIRECTLY.
             * =============================================== */

            activePhase =
                MorphPhase.Insert

            runPhase(
                progress =
                    phaseProgress,
                durationMillis =
                    spec.enterDurationMillis,
            )


            /* ===============================================
             * COMMIT
             * =============================================== */

            committedText =
                destination

            activePhase =
                null

            activeTransition =
                null
        }
    }


    /* ========================================================
     * DETERMINE WHAT WE ARE VISUALLY ANIMATING
     * ======================================================== */

    val transition =
        activeTransition

    val visualOldText =
        transition
            ?.plan
            ?.oldText
            ?: committedText

    val visualNewText =
        transition
            ?.plan
            ?.newText
            ?: committedText


    /* ========================================================
     * SEGMENT
     * ======================================================== */

    val oldGraphemes =
        remember(visualOldText) {
            segmentGraphemes(
                visualOldText
            )
        }

    val newGraphemes =
        remember(visualNewText) {
            segmentGraphemes(
                visualNewText
            )
        }


    /* ========================================================
     * MEASURE
     * ======================================================== */

    val oldWord =
        remember(
            visualOldText,
            style,
            textMeasurer,
        ) {
            measureWord(
                text =
                    visualOldText,
                graphemes =
                    oldGraphemes,
                textMeasurer =
                    textMeasurer,
                style =
                    style,
            )
        }

    val newWord =
        remember(
            visualNewText,
            style,
            textMeasurer,
        ) {
            measureWord(
                text =
                    visualNewText,
                graphemes =
                    newGraphemes,
                textMeasurer =
                    textMeasurer,
                style =
                    style,
            )
        }


    /* ========================================================
     * SIZE
     * ======================================================== */

    val widthPx =
        max(
            oldWord.width,
            newWord.width,
        )

    val heightPx =
        max(
            oldWord.height,
            newWord.height,
        )

    val density =
        LocalDensity.current

    val widthDp =
        with(density) {
            widthPx.toDp()
        }

    val heightDp =
        with(density) {
            heightPx.toDp()
        }


    /*
     * Read it during composition.
     *
     * This isn't strictly required—Compose also observes
     * snapshot reads in Canvas draw code—but keeping the
     * renderer input explicit makes the data flow clearer.
     */
    val currentProgress =
        phaseProgress.value

    val currentPhase =
        activePhase

    val frame =
        if (currentPhase != null) {
            calculateFrameProgress(
                phase =
                    currentPhase,
                progress =
                    currentProgress,
            )
        } else {
            null
        }


    /* ========================================================
     * DRAW
     * ======================================================== */

    Canvas(
        modifier =
            modifier
                .requiredSize(
                    width =
                        widthDp,
                    height =
                        heightDp,
                )
                .semantics {

                    /*
                     * Accessibility/test semantics remain on
                     * old text until the animation is complete.
                     */
                    this.text =
                        AnnotatedString(
                            committedText
                        )
                }
    ) {

        val currentTransition =
            activeTransition

        if (
            currentTransition == null ||
            frame == null
        ) {

            drawStableWord(
                word =
                    oldWord
            )

            return@Canvas
        }

        /*
         * During a transition this is the ONLY renderer.
         *
         * We do NOT draw the complete destination word.
         */
        drawTransition(
            plan =
                currentTransition.plan,
            oldWord =
                oldWord,
            newWord =
                newWord,
            frame =
                frame,
        )
    }
}


/* ============================================================
 * RUN ONE PHASE
 * ============================================================ */

private suspend fun runPhase(
    progress: Animatable<Float, *>,
    durationMillis: Int,
) {

    /*
     * Critical:
     * every phase starts at exactly 0.
     */
    progress.snapTo(0f)

    if (durationMillis == 0) {

        progress.snapTo(1f)

        return
    }

    /*
     * No easing.
     *
     * 50% elapsed time == 50% visual progress.
     */
    progress.animateTo(
        targetValue =
            1f,

        animationSpec =
            tween(
                durationMillis =
                    durationMillis,
                easing =
                    LinearEasing,
            ),
    )
}


/* ============================================================
 * PURE FRAME CALCULATION
 * ============================================================ */

@Immutable
internal data class FrameProgress(
    val exit: Float,
    val move: Float,
    val enter: Float,
)


internal fun calculateFrameProgress(
    phase: MorphPhase,
    progress: Float,
): FrameProgress {

    val p =
        progress.coerceIn(
            0f,
            1f,
        )

    return when (phase) {

        MorphPhase.Remove ->

            FrameProgress(
                exit =
                    p,
                move =
                    0f,
                enter =
                    0f,
            )

        MorphPhase.Move ->

            FrameProgress(
                exit =
                    1f,
                move =
                    p,
                enter =
                    0f,
            )

        MorphPhase.Insert ->

            FrameProgress(
                exit =
                    1f,
                move =
                    1f,
                enter =
                    p,
            )
    }
}


/* ============================================================
 * GRAPHEME SEGMENTATION
 * ============================================================ */

internal fun segmentGraphemes(
    text: String,
    locale: Locale =
        Locale.getDefault(),
): List<Grapheme> {

    if (text.isEmpty()) {
        return emptyList()
    }

    val iterator =
        BreakIterator
            .getCharacterInstance(
                locale
            )

    iterator.setText(text)

    val result =
        ArrayList<Grapheme>()

    var start =
        iterator.first()

    var end =
        iterator.next()

    while (
        end != BreakIterator.DONE
    ) {

        result +=
            Grapheme(
                text =
                    text.substring(
                        start,
                        end,
                    ),
                startOffset =
                    start,
                endOffset =
                    end,
            )

        start =
            end

        end =
            iterator.next()
    }

    return result
}


/* ============================================================
 * CREATE PLAN
 * ============================================================ */

internal fun createTransitionPlan(
    oldText: String,
    newText: String,
    matcher: MorphingTextMatcher =
        MinimumMovementMatcher,
): TransitionPlan {

    val old =
        segmentGraphemes(
            oldText
        )

    val new =
        segmentGraphemes(
            newText
        )

    val matches =
        matcher.match(
            old =
                old,
            new =
                new,
        )

    validateMatches(
        old =
            old,
        new =
            new,
        matches =
            matches,
    )

    val matchedOld =
        matches.mapTo(
            HashSet()
        ) {
            it.oldIndex
        }

    val matchedNew =
        matches.mapTo(
            HashSet()
        ) {
            it.newIndex
        }

    val removed =
        old.indices
            .filterTo(
                LinkedHashSet()
            ) {
                it !in matchedOld
            }

    val inserted =
        new.indices
            .filterTo(
                LinkedHashSet()
            ) {
                it !in matchedNew
            }

    return TransitionPlan(
        oldText =
            oldText,
        newText =
            newText,
        old =
            old,
        new =
            new,
        matches =
            matches,
        removedOldIndices =
            removed,
        insertedNewIndices =
            inserted,
    )
}


/* ============================================================
 * VALIDATE CUSTOM MATCHER
 * ============================================================ */

private fun validateMatches(
    old: List<Grapheme>,
    new: List<Grapheme>,
    matches: List<Match>,
) {

    var previousOld =
        -1

    var previousNew =
        -1

    val seenOld =
        HashSet<Int>()

    val seenNew =
        HashSet<Int>()

    matches.forEach { match ->

        require(
            match.oldIndex in
                old.indices
        ) {
            "Invalid oldIndex=${match.oldIndex}"
        }

        require(
            match.newIndex in
                new.indices
        ) {
            "Invalid newIndex=${match.newIndex}"
        }

        require(
            seenOld.add(
                match.oldIndex
            )
        ) {
            "oldIndex=${match.oldIndex} was matched more than once"
        }

        require(
            seenNew.add(
                match.newIndex
            )
        ) {
            "newIndex=${match.newIndex} was matched more than once"
        }

        require(
            old[
                match.oldIndex
            ].text ==
                new[
                    match.newIndex
                ].text
        ) {
            "Matcher matched different graphemes"
        }

        require(
            match.oldIndex >
                previousOld
        ) {
            "Old match indices must be increasing"
        }

        require(
            match.newIndex >
                previousNew
        ) {
            "New match indices must be increasing"
        }

        previousOld =
            match.oldIndex

        previousNew =
            match.newIndex
    }
}


/* ============================================================
 * MEASUREMENT
 * ============================================================ */

private data class MeasuredGrapheme(
    val grapheme: Grapheme,
    val x: Float,
    val layout: TextLayoutResult,
)


private data class MeasuredWord(
    val fullLayout: TextLayoutResult?,
    val graphemes: List<MeasuredGrapheme>,
    val width: Float,
    val height: Float,
)


private fun measureWord(
    text: String,
    graphemes: List<Grapheme>,
    textMeasurer: TextMeasurer,
    style: TextStyle,
): MeasuredWord {

    /*
     * Keep line height when the string is empty.
     */
    if (text.isEmpty()) {

        val probe =
            textMeasurer.measure(
                text =
                    AnnotatedString(
                        "Mg"
                    ),
                style =
                    style,
                softWrap =
                    false,
                maxLines =
                    1,
                constraints =
                    Constraints(),
            )

        return MeasuredWord(
            fullLayout =
                null,
            graphemes =
                emptyList(),
            width =
                0f,
            height =
                probe
                    .size
                    .height
                    .toFloat(),
        )
    }

    /*
     * Measure the complete word.
     *
     * Positions come from Compose's real text layout.
     */
    val fullLayout =
        textMeasurer.measure(
            text =
                AnnotatedString(
                    text
                ),
            style =
                style,
            softWrap =
                false,
            maxLines =
                1,
            constraints =
                Constraints(),
        )

    val measuredGraphemes =
        graphemes.map { grapheme ->

            /*
             * Position in the complete word.
             */
            val box =
                fullLayout.getBoundingBox(
                    grapheme.startOffset
                )

            /*
             * Separately drawable grapheme.
             */
            val isolatedLayout =
                textMeasurer.measure(
                    text =
                        AnnotatedString(
                            grapheme.text
                        ),
                    style =
                        style,
                    softWrap =
                        false,
                    maxLines =
                        1,
                    constraints =
                        Constraints(),
                )

            MeasuredGrapheme(
                grapheme =
                    grapheme,
                x =
                    box.left,
                layout =
                    isolatedLayout,
            )
        }

    return MeasuredWord(
        fullLayout =
            fullLayout,
        graphemes =
            measuredGraphemes,
        width =
            fullLayout
                .size
                .width
                .toFloat(),
        height =
            fullLayout
                .size
                .height
                .toFloat(),
    )
}


/* ============================================================
 * DRAW STABLE WORD
 * ============================================================ */

private fun DrawScope.drawStableWord(
    word: MeasuredWord,
) {

    val layout =
        word.fullLayout
            ?: return

    drawText(
        textLayoutResult =
            layout,
        topLeft =
            Offset.Zero,
    )
}


/* ============================================================
 * DRAW TRANSITION
 * ============================================================ */

private fun DrawScope.drawTransition(
    plan: TransitionPlan,
    oldWord: MeasuredWord,
    newWord: MeasuredWord,
    frame: FrameProgress,
) {

    val matchByOldIndex =
        plan.matches
            .associateBy {
                it.oldIndex
            }

    val matchedNewIndices =
        plan.matches
            .mapTo(
                HashSet()
            ) {
                it.newIndex
            }


    /* --------------------------------------------------------
     * OLD GLYPHS
     * -------------------------------------------------------- */

    oldWord.graphemes
        .forEachIndexed {
                oldIndex,
                oldGrapheme ->

            val match =
                matchByOldIndex[
                    oldIndex
                ]

            if (match == null) {

                /*
                 * Removed:
                 *
                 * fixed X
                 * alpha 1 -> 0
                 */
                drawGrapheme(
                    grapheme =
                        oldGrapheme,
                    x =
                        oldGrapheme.x,
                    alpha =
                        1f -
                            frame.exit,
                )

            } else {

                /*
                 * Survivor:
                 *
                 * SAME object.
                 *
                 * Never fades.
                 * Only moves during MOVE.
                 */
                val destination =
                    newWord.graphemes[
                        match.newIndex
                    ]

                val x =
                    lerp(
                        start =
                            oldGrapheme.x,
                        end =
                            destination.x,
                        fraction =
                            frame.move,
                    )

                drawGrapheme(
                    grapheme =
                        oldGrapheme,
                    x =
                        x,
                    alpha =
                        1f,
                )
            }
        }


    /* --------------------------------------------------------
     * NEW-ONLY GLYPHS
     * -------------------------------------------------------- */

    newWord.graphemes
        .forEachIndexed {
                newIndex,
                newGrapheme ->

            /*
             * Critical:
             *
             * matched destination graphemes are NOT drawn.
             *
             * The old survivor represents them.
             */
            if (
                newIndex in
                matchedNewIndices
            ) {
                return@forEachIndexed
            }

            /*
             * Inserted:
             *
             * final X from the beginning
             * invisible during REMOVE/MOVE
             * alpha 0 -> 1 during INSERT
             */
            drawGrapheme(
                grapheme =
                    newGrapheme,
                x =
                    newGrapheme.x,
                alpha =
                    frame.enter,
            )
        }
}


/* ============================================================
 * DRAW ONE GRAPHEME
 * ============================================================ */

private fun DrawScope.drawGrapheme(
    grapheme: MeasuredGrapheme,
    x: Float,
    alpha: Float,
) {

    val safeAlpha =
        alpha.coerceIn(
            0f,
            1f,
        )

    if (safeAlpha <= 0f) {
        return
    }

    drawText(
        textLayoutResult =
            grapheme.layout,
        topLeft =
            Offset(
                x =
                    x,
                y =
                    0f,
            ),
        alpha =
            safeAlpha,
    )
}


/* ============================================================
 * LINEAR INTERPOLATION
 * ============================================================ */

private fun lerp(
    start: Float,
    end: Float,
    fraction: Float,
): Float {

    val p =
        fraction.coerceIn(
            0f,
            1f,
        )

    return start +
        (
            end - start
        ) * p
}
