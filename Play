// =============================================================================
// Speech API
// =============================================================================

interface SpeechEngine {

    fun speak(
        text: String,
        utteranceId: String,
        listener: Listener,
    )

    fun stop()

    interface Listener {

        fun onStart(
            utteranceId: String,
        )

        /**
         * Range uses:
         *
         * [start, endExclusive)
         *
         * against the original transcript.
         */
        fun onRangeStart(
            utteranceId: String,
            start: Int,
            endExclusive: Int,
        )

        fun onDone(
            utteranceId: String,
        )

        fun onError(
            utteranceId: String,
        )
    }
}


// =============================================================================
// Android TextToSpeech implementation
// =============================================================================

class AndroidSpeechEngine(
    context: Context,
) : SpeechEngine {

    private var listener: SpeechEngine.Listener? = null

    private var initialized = false

    private val textToSpeech: TextToSpeech

    init {
        textToSpeech = TextToSpeech(
            context.applicationContext,
        ) { status ->

            initialized =
                status == TextToSpeech.SUCCESS

            if (initialized) {
                textToSpeech.language =
                    Locale.getDefault()
            }
        }

        textToSpeech.setOnUtteranceProgressListener(
            object : UtteranceProgressListener() {

                override fun onStart(
                    utteranceId: String,
                ) {
                    listener?.onStart(
                        utteranceId,
                    )
                }

                override fun onRangeStart(
                    utteranceId: String,
                    start: Int,
                    end: Int,
                    frame: Int,
                ) {
                    listener?.onRangeStart(
                        utteranceId = utteranceId,
                        start = start,
                        endExclusive = end,
                    )
                }

                override fun onDone(
                    utteranceId: String,
                ) {
                    listener?.onDone(
                        utteranceId,
                    )
                }

                @Deprecated(
                    "Deprecated Android callback",
                )
                override fun onError(
                    utteranceId: String,
                ) {
                    listener?.onError(
                        utteranceId,
                    )
                }

                override fun onError(
                    utteranceId: String,
                    errorCode: Int,
                ) {
                    listener?.onError(
                        utteranceId,
                    )
                }
            },
        )
    }

    override fun speak(
        text: String,
        utteranceId: String,
        listener: SpeechEngine.Listener,
    ) {
        this.listener = listener

        if (!initialized) {
            listener.onError(utteranceId)
            return
        }

        textToSpeech.speak(
            text,
            TextToSpeech.QUEUE_FLUSH,
            null,
            utteranceId,
        )
    }

    override fun stop() {
        textToSpeech.stop()
    }

    fun shutdown() {
        listener = null
        textToSpeech.stop()
        textToSpeech.shutdown()
    }
}


// =============================================================================
// State
// =============================================================================

data class ReadAloudState(
    val transcript: String,
    val isPlaying: Boolean = false,

    /**
     * Stored as Kotlin IntRange.
     *
     * TTS:
     * [start, endExclusive)
     *
     * becomes:
     * start until endExclusive
     */
    val activeRange: IntRange? = null,
)


fun interface UtteranceIdGenerator {
    fun next(): String
}


interface ReadAloudController {

    val state: StateFlow<ReadAloudState>

    fun play()

    fun stop()

    fun setTranscript(
        transcript: String,
    )

    fun dispose()
}


// =============================================================================
// Thread-safe controller
// =============================================================================

class DefaultReadAloudController(
    initialTranscript: String,
    private val speechEngine: SpeechEngine,
    private val idGenerator: UtteranceIdGenerator =
        UtteranceIdGenerator {
            UUID.randomUUID().toString()
        },
) : ReadAloudController {

    /*
     * TTS callbacks may arrive asynchronously.
     *
     * Both the public state and current utterance identity
     * are protected by the same lock.
     */
    private val lock = Any()

    private var currentUtteranceId: String? =
        null

    private var disposed =
        false

    private val _state =
        MutableStateFlow(
            ReadAloudState(
                transcript =
                    initialTranscript,
            ),
        )

    override val state:
        StateFlow<ReadAloudState> =
        _state.asStateFlow()


    // -------------------------------------------------------------------------
    // Play
    // -------------------------------------------------------------------------

    override fun play() {

        val text: String
        val utteranceId: String
        val previousSessionExists: Boolean

        synchronized(lock) {

            if (disposed) {
                return
            }

            text =
                _state.value.transcript

            if (text.isEmpty()) {
                return
            }

            /*
             * A new ID is generated for every playback.
             *
             * This is required even when replaying exactly
             * the same transcript.
             */
            utteranceId =
                idGenerator.next()

            previousSessionExists =
                currentUtteranceId != null

            /*
             * Installing the new ID immediately invalidates
             * callbacks from the previous session.
             */
            currentUtteranceId =
                utteranceId

            _state.value =
                _state.value.copy(
                    isPlaying = true,
                    activeRange = null,
                )
        }

        /*
         * Do not call external code while holding lock.
         */
        if (previousSessionExists) {
            speechEngine.stop()
        }

        speechEngine.speak(
            text = text,
            utteranceId = utteranceId,
            listener = listener,
        )
    }


    // -------------------------------------------------------------------------
    // Stop
    // -------------------------------------------------------------------------

    override fun stop() {

        val shouldStop: Boolean

        synchronized(lock) {

            if (disposed) {
                return
            }

            shouldStop =
                currentUtteranceId != null ||
                    _state.value.isPlaying

            /*
             * Invalidate the session BEFORE asking
             * the external engine to stop.
             */
            currentUtteranceId =
                null

            _state.value =
                _state.value.copy(
                    isPlaying = false,
                    activeRange = null,
                )
        }

        if (shouldStop) {
            speechEngine.stop()
        }
    }


    // -------------------------------------------------------------------------
    // Transcript replacement
    // -------------------------------------------------------------------------

    override fun setTranscript(
        transcript: String,
    ) {

        val shouldStop: Boolean

        synchronized(lock) {

            if (disposed) {
                return
            }

            if (
                _state.value.transcript ==
                transcript
            ) {
                return
            }

            shouldStop =
                currentUtteranceId != null ||
                    _state.value.isPlaying

            /*
             * Immediately invalidate callbacks
             * belonging to the previous transcript.
             */
            currentUtteranceId =
                null

            _state.value =
                ReadAloudState(
                    transcript =
                        transcript,
                    isPlaying =
                        false,
                    activeRange =
                        null,
                )
        }

        if (shouldStop) {
            speechEngine.stop()
        }
    }


    // -------------------------------------------------------------------------
    // Dispose
    // -------------------------------------------------------------------------

    override fun dispose() {

        val shouldStop: Boolean

        synchronized(lock) {

            if (disposed) {
                return
            }

            shouldStop =
                currentUtteranceId != null ||
                    _state.value.isPlaying

            /*
             * Mark disposed first so any concurrent
             * callback becomes invalid.
             */
            disposed =
                true

            currentUtteranceId =
                null

            _state.value =
                _state.value.copy(
                    isPlaying = false,
                    activeRange = null,
                )
        }

        if (shouldStop) {
            speechEngine.stop()
        }
    }


    // -------------------------------------------------------------------------
    // TTS listener
    // -------------------------------------------------------------------------

    private val listener =
        object : SpeechEngine.Listener {

            override fun onStart(
                utteranceId: String,
            ) {
                /*
                 * Nothing required.
                 *
                 * We consider playback active immediately
                 * after Play is pressed.
                 */
            }


            override fun onRangeStart(
                utteranceId: String,
                start: Int,
                endExclusive: Int,
            ) {

                synchronized(lock) {

                    /*
                     * Ignore callbacks from old,
                     * stopped or disposed sessions.
                     */
                    if (
                        !isCurrentLocked(
                            utteranceId,
                        )
                    ) {
                        return
                    }

                    val transcript =
                        _state.value.transcript

                    /*
                     * Valid range:
                     *
                     * 0 <= start
                     * start < endExclusive
                     * endExclusive <= text.length
                     */
                    val valid =
                        start >= 0 &&
                            endExclusive > start &&
                            endExclusive <=
                            transcript.length

                    if (!valid) {
                        /*
                         * Invalid callback must NOT
                         * clear an existing valid
                         * highlight.
                         */
                        return
                    }

                    _state.value =
                        _state.value.copy(
                            activeRange =
                                start until
                                    endExclusive,
                        )
                }
            }


            override fun onDone(
                utteranceId: String,
            ) {
                finish(
                    utteranceId,
                )
            }


            override fun onError(
                utteranceId: String,
            ) {
                finish(
                    utteranceId,
                )
            }
        }


    // -------------------------------------------------------------------------
    // Terminal callback
    // -------------------------------------------------------------------------

    private fun finish(
        utteranceId: String,
    ) {

        synchronized(lock) {

            if (
                !isCurrentLocked(
                    utteranceId,
                )
            ) {
                return
            }

            /*
             * Invalidate ID.
             *
             * Any later range callback for this
             * utterance will now be ignored.
             */
            currentUtteranceId =
                null

            _state.value =
                _state.value.copy(
                    isPlaying = false,
                    activeRange = null,
                )
        }
    }


    private fun isCurrentLocked(
        utteranceId: String,
    ): Boolean =
        !disposed &&
            _state.value.isPlaying &&
            currentUtteranceId ==
                utteranceId
}


// =============================================================================
// Visual-line representation
// =============================================================================

private data class VisibleLine(
    val text: String,
    val sourceStart: Int,
    val sourceEndExclusive: Int,
)


// =============================================================================
// Determine which visual line should be displayed
// =============================================================================

private fun visibleLineFor(
    transcript: String,
    layout: TextLayoutResult,
    activeRange: IntRange?,
): VisibleLine {

    if (transcript.isEmpty()) {

        return VisibleLine(
            text = "",
            sourceStart = 0,
            sourceEndExclusive = 0,
        )
    }

    /*
     * No active speech:
     *
     * display the first visual line.
     */
    val requestedOffset =
        activeRange?.first ?: 0

    val safeOffset =
        requestedOffset.coerceIn(
            minimumValue = 0,
            maximumValue =
                transcript.lastIndex,
        )

    /*
     * Compose knows which visual line owns
     * this character position.
     */
    val lineIndex =
        layout.getLineForOffset(
            safeOffset,
        )

    val start =
        layout.getLineStart(
            lineIndex,
        )

    /*
     * visibleEnd=true removes trailing
     * spaces/newline characters from the
     * visible line.
     */
    val endExclusive =
        layout.getLineEnd(
            lineIndex = lineIndex,
            visibleEnd = true,
        ).coerceAtLeast(start)

    return VisibleLine(
        text =
            transcript.substring(
                startIndex = start,
                endIndex = endExclusive,
            ),
        sourceStart =
            start,
        sourceEndExclusive =
            endExclusive,
    )
}


// =============================================================================
// Convert global TTS range to line-local range
// =============================================================================

private fun localHighlightRange(
    activeRange: IntRange?,
    line: VisibleLine,
): IntRange? {

    if (activeRange == null) {
        return null
    }

    if (line.text.isEmpty()) {
        return null
    }

    /*
     * Convert Kotlin's inclusive IntRange back
     * into [start, endExclusive).
     */
    val activeStart =
        activeRange.first

    val activeEndExclusive =
        activeRange.last + 1

    /*
     * Calculate intersection between:
     *
     * active speech range
     *
     * and
     *
     * displayed visual line.
     */
    val intersectionStart =
        maxOf(
            activeStart,
            line.sourceStart,
        )

    val intersectionEndExclusive =
        minOf(
            activeEndExclusive,
            line.sourceEndExclusive,
        )

    if (
        intersectionStart >=
        intersectionEndExclusive
    ) {
        return null
    }

    /*
     * Convert transcript-global positions
     * into positions inside line.text.
     */
    val localStart =
        intersectionStart -
            line.sourceStart

    val localEndExclusive =
        intersectionEndExclusive -
            line.sourceStart

    return localStart until
        localEndExclusive
}


// =============================================================================
// Visual constants
// =============================================================================

private val SpokenWordOrange =
    Color(0xFFFF9800)

private val TranscriptTextStyle =
    TextStyle(
        fontSize = 20.sp,
        textAlign = TextAlign.Center,
    )


// =============================================================================
// Transcript rendering
// =============================================================================

@Composable
private fun ReadAloudTranscriptContent(
    transcript: String,
    activeRange: IntRange?,
    modifier: Modifier = Modifier,
) {

    /*
     * Empty transcript has no visible text.
     */
    if (transcript.isEmpty()) {
        return
    }

    val textMeasurer =
        rememberTextMeasurer()

    /*
     * Width in physical pixels.
     *
     * TextMeasurer constraints operate in px,
     * so onSizeChanged gives exactly what we need.
     */
    var availableWidthPx by
        remember {
            mutableIntStateOf(0)
        }

    Box(
        modifier =
            modifier
                .clipToBounds()
                .onSizeChanged { size ->
                    availableWidthPx =
                        size.width
                },
    ) {

        /*
         * First layout pass may not have a
         * measured width yet.
         */
        if (availableWidthPx <= 0) {
            return@Box
        }

        /*
         * IMPORTANT:
         *
         * Measure the COMPLETE transcript.
         *
         * Wrapping is enabled.
         *
         * We must allow Compose to determine:
         *
         * line 0
         * line 1
         * line 2
         * ...
         *
         * before selecting the line containing
         * the active spoken range.
         */
        val layout =
            textMeasurer.measure(
                text =
                    AnnotatedString(
                        transcript,
                    ),
                style =
                    TranscriptTextStyle,
                softWrap =
                    true,
                overflow =
                    TextOverflow.Clip,
                constraints =
                    Constraints(
                        maxWidth =
                            availableWidthPx,
                    ),
            )

        /*
         * Select exactly one visual line.
         */
        val visibleLine =
            visibleLineFor(
                transcript =
                    transcript,
                layout =
                    layout,
                activeRange =
                    activeRange,
            )

        /*
         * Determine which portion of the
         * displayed line should be orange.
         */
        val localHighlight =
            localHighlightRange(
                activeRange =
                    activeRange,
                line =
                    visibleLine,
            )

        /*
         * Build displayed line.
         */
        val annotatedLine =
            buildAnnotatedString {

                append(
                    visibleLine.text,
                )

                if (
                    localHighlight != null
                ) {

                    addStyle(
                        style =
                            SpanStyle(
                                /*
                                 * ONLY foreground color changes.
                                 *
                                 * No bold.
                                 * No font-size change.
                                 * No spacing change.
                                 *
                                 * Therefore highlighting cannot
                                 * cause text reflow.
                                 */
                                color =
                                    SpokenWordOrange,
                            ),
                        start =
                            localHighlight.first,
                        end =
                            localHighlight.last + 1,
                    )
                }
            }

        /*
         * Render only the selected visual line.
         */
        Text(
            text =
                annotatedLine,
            modifier =
                Modifier.fillMaxWidth(),
            style =
                TranscriptTextStyle,
            maxLines =
                1,
            softWrap =
                false,
            overflow =
                TextOverflow.Clip,
        )
    }
}


// =============================================================================
// Main reusable component
// =============================================================================

@Composable
fun ReadAloudTranscript(
    transcript: String,
    speechEngine: SpeechEngine,
    modifier: Modifier = Modifier,
) {

    /*
     * Controller survives recompositions.
     *
     * If a different SpeechEngine is supplied,
     * Compose creates a new controller.
     */
    val controller =
        remember(speechEngine) {

            DefaultReadAloudController(
                initialTranscript =
                    transcript,
                speechEngine =
                    speechEngine,
            )
        }

    /*
     * Handle transcript parameter changes.
     */
    LaunchedEffect(
        controller,
        transcript,
    ) {

        controller.setTranscript(
            transcript,
        )
    }

    /*
     * Leaving composition invalidates playback.
     */
    DisposableEffect(controller) {

        onDispose {
            controller.dispose()
        }
    }

    val state by
        controller.state
            .collectAsState()

    /*
     * UI:
     *
     *          Play / Stop
     *
     *      transcript line
     */
    Column(
        modifier =
            modifier.fillMaxWidth(),
        horizontalAlignment =
            Alignment.CenterHorizontally,
    ) {

        /*
         * Exactly one button.
         */
        Button(
            enabled =
                state.transcript
                    .isNotEmpty(),
            onClick = {

                if (state.isPlaying) {

                    controller.stop()

                } else {

                    controller.play()
                }
            },
        ) {

            Text(
                text =
                    if (
                        state.isPlaying
                    ) {
                        "Stop"
                    } else {
                        "Play"
                    },
            )
        }

        Spacer(
            modifier =
                Modifier.height(24.dp),
        )

        /*
         * Exactly one transcript visual line.
         */
        ReadAloudTranscriptContent(
            transcript =
                state.transcript,
            activeRange =
                state.activeRange,
            modifier =
                Modifier.fillMaxWidth(),
        )
    }
}


// =============================================================================
// Screen / usage from another Composable
// =============================================================================

@Composable
fun TranscriptScreen(
    modifier: Modifier = Modifier,
) {

    val context =
        LocalContext.current

    /*
     * The Android TTS engine is created once for
     * this screen.
     */
    val speechEngine =
        remember {
            AndroidSpeechEngine(
                context =
                    context.applicationContext,
            )
        }

    /*
     * Android TextToSpeech owns native resources,
     * so release them when this screen permanently
     * leaves composition.
     */
    DisposableEffect(speechEngine) {

        onDispose {
            speechEngine.shutdown()
        }
    }

    val transcript =
        """
        The quick brown fox jumps over the lazy dog. 
        Jetpack Compose makes Android UI development easier and more declarative.
        This transcript is read aloud one word at a time.
        """.trimIndent()

    /*
     * Whole screen.
     */
    Column(
        modifier =
            modifier
                .fillMaxSize()
                .padding(24.dp),
        horizontalAlignment =
            Alignment.CenterHorizontally,
    ) {

        ReadAloudTranscript(
            transcript =
                transcript,
            speechEngine =
                speechEngine,
            modifier =
                Modifier.fillMaxWidth(),
        )
    }
}
