/* ============================================================
 * ANIMATION SPEC
 *
 * These values are the actual animation durations.
 *
 * exitDurationMillis:
 *     old-only glyph alpha 1 -> 0
 *
 * moveDurationMillis:
 *     survivor position oldX -> newX
 *
 * enterDurationMillis:
 *     new-only glyph alpha 0 -> 1
 * ============================================================ */

@Immutable
data class MorphingTextAnimationSpec(
    val exitDurationMillis: Int = 100,
    val moveDurationMillis: Int = 200,
    val enterDurationMillis: Int = 100,
) {

    init {
        require(exitDurationMillis >= 0) {
            "exitDurationMillis must be >= 0"
        }

        require(moveDurationMillis >= 0) {
            "moveDurationMillis must be >= 0"
        }

        require(enterDurationMillis >= 0) {
            "enterDurationMillis must be >= 0"
        }
    }

    val totalDurationMillis: Int
        get() =
            exitDurationMillis +
                moveDurationMillis +
                enterDurationMillis
}


/* ============================================================
 * GRAPHEME
 * ============================================================ */

@Immutable
data class Grapheme(
    val text: String,
    val startOffset: Int,
    val endOffset: Int,
)


/* ============================================================
 * MATCH
 * ============================================================ */

@Immutable
data class Match(
    val oldIndex: Int,
    val newIndex: Int,
)


/* ============================================================
 * MATCHER CONTRACT
 * ============================================================ */

fun interface MorphingTextMatcher {

    fun match(
        old: List<Grapheme>,
        new: List<Grapheme>,
    ): List<Match>
}


/* ============================================================
 * DEFAULT MATCHER
 *
 * Rules:
 *
 * 1. Reuse maximum number of graphemes.
 * 2. Minimize total movement.
 * 3. Preserve relative order.
 * 4. Deterministic tie-break.
 * ============================================================ */

object MinimumMovementMatcher : MorphingTextMatcher {

    private data class Candidate(
        val matches: List<Match>,
        val movementCost: Int,
    )


    override fun match(
        old: List<Grapheme>,
        new: List<Grapheme>,
    ): List<Match> {

        if (
            old.isEmpty() ||
            new.isEmpty()
        ) {
            return emptyList()
        }


        val memo =
            HashMap<Pair<Int, Int>, Candidate>()


        fun compareMatches(
            first: List<Match>,
            second: List<Match>,
        ): Int {

            val count =
                minOf(
                    first.size,
                    second.size,
                )


            for (index in 0 until count) {

                val a =
                    first[index]

                val b =
                    second[index]


                if (
                    a.oldIndex !=
                    b.oldIndex
                ) {
                    return a.oldIndex.compareTo(
                        b.oldIndex
                    )
                }


                if (
                    a.newIndex !=
                    b.newIndex
                ) {
                    return a.newIndex.compareTo(
                        b.newIndex
                    )
                }
            }


            return first.size.compareTo(
                second.size
            )
        }


        fun better(
            first: Candidate,
            second: Candidate,
        ): Candidate {

            /*
             * Priority 1:
             * reuse maximum graphemes.
             */
            if (
                first.matches.size !=
                second.matches.size
            ) {
                return if (
                    first.matches.size >
                    second.matches.size
                ) {
                    first
                } else {
                    second
                }
            }


            /*
             * Priority 2:
             * minimum movement.
             */
            if (
                first.movementCost !=
                second.movementCost
            ) {
                return if (
                    first.movementCost <
                    second.movementCost
                ) {
                    first
                } else {
                    second
                }
            }


            /*
             * Priority 3:
             * deterministic tie-break.
             */
            return if (
                compareMatches(
                    first.matches,
                    second.matches,
                ) <= 0
            ) {
                first
            } else {
                second
            }
        }


        fun solve(
            oldIndex: Int,
            newIndex: Int,
        ): Candidate {

            if (
                oldIndex >= old.size ||
                newIndex >= new.size
            ) {
                return Candidate(
                    matches =
                        emptyList(),
                    movementCost =
                        0,
                )
            }


            val key =
                oldIndex to newIndex


            memo[key]?.let {
                return it
            }


            /*
             * Option 1:
             * old grapheme is removed.
             */
            var best =
                solve(
                    oldIndex + 1,
                    newIndex,
                )


            /*
             * Option 2:
             * new grapheme is inserted.
             */
            best =
                better(
                    best,
                    solve(
                        oldIndex,
                        newIndex + 1,
                    ),
                )


            /*
             * Option 3:
             * reuse grapheme.
             */
            if (
                old[oldIndex].text ==
                new[newIndex].text
            ) {

                val suffix =
                    solve(
                        oldIndex + 1,
                        newIndex + 1,
                    )


                val candidate =
                    Candidate(
                        matches =
                            listOf(
                                Match(
                                    oldIndex =
                                        oldIndex,
                                    newIndex =
                                        newIndex,
                                )
                            ) +
                                suffix.matches,

                        movementCost =
                            abs(
                                oldIndex -
                                    newIndex
                            ) +
                                suffix.movementCost,
                    )


                best =
                    better(
                        best,
                        candidate,
                    )
            }


            memo[key] =
                best


            return best
        }


        return solve(
            oldIndex = 0,
            newIndex = 0,
        ).matches
    }
}


/* ============================================================
 * TRANSITION PLAN
 * ============================================================ */

@Immutable
data class TransitionPlan(
    val oldText: String,
    val newText: String,
    val old: List<Grapheme>,
    val new: List<Grapheme>,
    val matches: List<Match>,
    val removedOldIndices: Set<Int>,
    val insertedNewIndices: Set<Int>,
)


@Immutable
private data class ActiveTransition(
    val plan: TransitionPlan,
    val spec: MorphingTextAnimationSpec,
)


/* ============================================================
 * MORPHING TEXT
 * ============================================================ */

@Composable
fun MorphingText(
    text: String,
    modifier: Modifier = Modifier,
    style: TextStyle = LocalTextStyle.current,
    animationSpec: MorphingTextAnimationSpec =
        MorphingTextAnimationSpec(),
    matcher: MorphingTextMatcher =
        MinimumMovementMatcher,
) {

    val textMeasurer =
        rememberTextMeasurer(
            cacheSize = 64
        )


    /* ========================================================
     * COMMITTED TEXT
     *
     * This is the text that has COMPLETELY finished animating.
     *
     * Accessibility semantics also use this.
     * ======================================================== */

    var committedText by remember {
        mutableStateOf(text)
    }


    /* ========================================================
     * ACTIVE TRANSITION
     *
     * null = idle
     * ======================================================== */

    var activeTransition by remember {
        mutableStateOf<ActiveTransition?>(null)
    }


    /* ========================================================
     * ACTUAL VISUAL ANIMATION VALUES
     *
     * These are deliberately separate.
     *
     * No normalized global timeline.
     * No phase conversion.
     * No duration-as-delay.
     * ======================================================== */


    /*
     * REMOVE
     *
     * 1 = fully visible
     * 0 = invisible
     */
    val exitAlpha =
        remember {
            Animatable(
                initialValue = 1f
            )
        }


    /*
     * MOVE
     *
     * 0 = old position
     * 1 = destination position
     */
    val moveProgress =
        remember {
            Animatable(
                initialValue = 0f
            )
        }


    /*
     * INSERT
     *
     * 0 = invisible
     * 1 = fully visible
     */
    val enterAlpha =
        remember {
            Animatable(
                initialValue = 0f
            )
        }


    /* ========================================================
     * REQUEST QUEUE
     *
     * Finish current transition.
     *
     * While it runs, keep only the latest requested text.
     * ======================================================== */

    val requests =
        remember {
            Channel<String>(
                capacity =
                    Channel.CONFLATED
            )
        }


    /*
     * Worker is long-lived.
     *
     * These wrappers allow it to read latest configuration
     * without restarting the coroutine.
     */
    val latestSpec by
        rememberUpdatedState(
            animationSpec
        )


    val latestMatcher by
        rememberUpdatedState(
            matcher
        )


    /* ========================================================
     * TARGET PRODUCER
     * ======================================================== */

    LaunchedEffect(text) {

        if (
            text != committedText
        ) {

            requests.trySend(
                text
            )
        }
    }


    /* ========================================================
     * ANIMATION WORKER
     * ======================================================== */

    LaunchedEffect(Unit) {

        for (
            destination in requests
        ) {

            /*
             * Ignore obsolete requests.
             */
            if (
                destination ==
                committedText
            ) {
                continue
            }


            /*
             * Freeze spec/matcher for this transition.
             */
            val spec =
                latestSpec


            val matcherForTransition =
                latestMatcher


            /*
             * Build:
             *
             * committed -> destination
             */
            val plan =
                createTransitionPlan(
                    oldText =
                        committedText,
                    newText =
                        destination,
                    matcher =
                        matcherForTransition,
                )


            /* =================================================
             * RESET VISUAL STATE
             *
             * Do this BEFORE publishing activeTransition.
             *
             * This prevents a frame where a new transition
             * accidentally inherits previous alpha/progress.
             * ================================================= */

            exitAlpha.snapTo(
                1f
            )

            moveProgress.snapTo(
                0f
            )

            enterAlpha.snapTo(
                0f
            )


            /*
             * Renderer can now see the transition.
             */
            activeTransition =
                ActiveTransition(
                    plan =
                        plan,
                    spec =
                        spec,
                )


            /* =================================================
             * PHASE 1 — REMOVE
             *
             * THIS IS THE FADE.
             *
             * There is NO delay.
             *
             * exitAlpha starts changing immediately:
             *
             * 1.00
             * 0.99
             * 0.98
             * ...
             * 0.00
             *
             * over exitDurationMillis.
             * ================================================= */

            if (
                spec.exitDurationMillis ==
                0
            ) {

                exitAlpha.snapTo(
                    0f
                )

            } else {

                exitAlpha.animateTo(
                    targetValue =
                        0f,

                    animationSpec =
                        tween(
                            durationMillis =
                                spec.exitDurationMillis,

                            delayMillis =
                                0,

                            easing =
                                LinearEasing,
                        ),
                )
            }


            /* =================================================
             * PHASE 2 — MOVE
             *
             * Starts only after REMOVE finishes.
             * ================================================= */

            if (
                spec.moveDurationMillis ==
                0
            ) {

                moveProgress.snapTo(
                    1f
                )

            } else {

                moveProgress.animateTo(
                    targetValue =
                        1f,

                    animationSpec =
                        tween(
                            durationMillis =
                                spec.moveDurationMillis,

                            delayMillis =
                                0,

                            easing =
                                LinearEasing,
                        ),
                )
            }


            /* =================================================
             * PHASE 3 — INSERT
             *
             * THIS IS THE FADE-IN.
             *
             * There is NO delay.
             *
             * enterAlpha starts changing immediately:
             *
             * 0.00
             * 0.01
             * 0.02
             * ...
             * 1.00
             *
             * over enterDurationMillis.
             * ================================================= */

            if (
                spec.enterDurationMillis ==
                0
            ) {

                enterAlpha.snapTo(
                    1f
                )

            } else {

                enterAlpha.animateTo(
                    targetValue =
                        1f,

                    animationSpec =
                        tween(
                            durationMillis =
                                spec.enterDurationMillis,

                            delayMillis =
                                0,

                            easing =
                                LinearEasing,
                        ),
                )
            }


            /* =================================================
             * COMMIT
             *
             * Destination becomes the real text only after:
             *
             * REMOVE complete
             * MOVE complete
             * INSERT complete
             * ================================================= */

            committedText =
                destination


            activeTransition =
                null
        }
    }


    /* ========================================================
     * CURRENT VISUAL SOURCE / DESTINATION
     * ======================================================== */

    val transition =
        activeTransition


    val visualOldText =
        transition
            ?.plan
            ?.oldText
            ?: committedText


    val visualNewText =
        transition
            ?.plan
            ?.newText
            ?: committedText


    /* ========================================================
     * SEGMENT
     * ======================================================== */

    val oldGraphemes =
        remember(
            visualOldText
        ) {

            segmentGraphemes(
                visualOldText
            )
        }


    val newGraphemes =
        remember(
            visualNewText
        ) {

            segmentGraphemes(
                visualNewText
            )
        }


    /* ========================================================
     * MEASURE
     * ======================================================== */

    val oldWord =
        remember(
            visualOldText,
            style,
            textMeasurer,
        ) {

            measureWord(
                text =
                    visualOldText,
                graphemes =
                    oldGraphemes,
                textMeasurer =
                    textMeasurer,
                style =
                    style,
            )
        }


    val newWord =
        remember(
            visualNewText,
            style,
            textMeasurer,
        ) {

            measureWord(
                text =
                    visualNewText,
                graphemes =
                    newGraphemes,
                textMeasurer =
                    textMeasurer,
                style =
                    style,
            )
        }


    /* ========================================================
     * CANVAS SIZE
     * ======================================================== */

    val widthPx =
        max(
            oldWord.width,
            newWord.width,
        )


    val heightPx =
        max(
            oldWord.height,
            newWord.height,
        )


    val density =
        LocalDensity.current


    val widthDp =
        with(density) {
            widthPx.toDp()
        }


    val heightDp =
        with(density) {
            heightPx.toDp()
        }


    /* ========================================================
     * READ ACTUAL ANIMATED VALUES
     *
     * These reads cause Compose to update as Animatable changes.
     * ======================================================== */

    val currentExitAlpha =
        exitAlpha.value


    val currentMoveProgress =
        moveProgress.value


    val currentEnterAlpha =
        enterAlpha.value


    /* ========================================================
     * RENDER
     * ======================================================== */

    Canvas(
        modifier =
            modifier
                .requiredSize(
                    width =
                        widthDp,
                    height =
                        heightDp,
                )
                .semantics {

                    /*
                     * Do NOT expose destination early.
                     */
                    this.text =
                        AnnotatedString(
                            committedText
                        )
                }
    ) {

        val currentTransition =
            transition


        if (
            currentTransition ==
            null
        ) {

            drawStableWord(
                word =
                    oldWord
            )


            return@Canvas
        }


        /*
         * IMPORTANT:
         *
         * During animation, ONLY this function draws the text.
         *
         * Do not also draw:
         *
         * Text(text)
         * Text(oldText)
         * Text(newText)
         *
         * elsewhere over this Canvas.
         */
        drawTransition(
            plan =
                currentTransition.plan,

            oldWord =
                oldWord,

            newWord =
                newWord,

            exitAlpha =
                currentExitAlpha,

            moveProgress =
                currentMoveProgress,

            enterAlpha =
                currentEnterAlpha,
        )
    }
}


/* ============================================================
 * SEGMENT INTO GRAPHEMES
 * ============================================================ */

internal fun segmentGraphemes(
    text: String,
    locale: Locale =
        Locale.getDefault(),
): List<Grapheme> {

    if (
        text.isEmpty()
    ) {
        return emptyList()
    }


    val iterator =
        BreakIterator
            .getCharacterInstance(
                locale
            )


    iterator.setText(
        text
    )


    val result =
        ArrayList<Grapheme>()


    var start =
        iterator.first()


    var end =
        iterator.next()


    while (
        end !=
        BreakIterator.DONE
    ) {

        result +=
            Grapheme(
                text =
                    text.substring(
                        start,
                        end,
                    ),

                startOffset =
                    start,

                endOffset =
                    end,
            )


        start =
            end


        end =
            iterator.next()
    }


    return result
}


/* ============================================================
 * CREATE TRANSITION PLAN
 * ============================================================ */

internal fun createTransitionPlan(
    oldText: String,
    newText: String,
    matcher: MorphingTextMatcher =
        MinimumMovementMatcher,
): TransitionPlan {

    val old =
        segmentGraphemes(
            oldText
        )


    val new =
        segmentGraphemes(
            newText
        )


    val matches =
        matcher.match(
            old =
                old,
            new =
                new,
        )


    validateMatches(
        old =
            old,
        new =
            new,
        matches =
            matches,
    )


    val matchedOld =
        matches.mapTo(
            HashSet()
        ) {
            it.oldIndex
        }


    val matchedNew =
        matches.mapTo(
            HashSet()
        ) {
            it.newIndex
        }


    val removed =
        old.indices
            .filterTo(
                LinkedHashSet()
            ) {
                it !in matchedOld
            }


    val inserted =
        new.indices
            .filterTo(
                LinkedHashSet()
            ) {
                it !in matchedNew
            }


    return TransitionPlan(
        oldText =
            oldText,

        newText =
            newText,

        old =
            old,

        new =
            new,

        matches =
            matches,

        removedOldIndices =
            removed,

        insertedNewIndices =
            inserted,
    )
}


/* ============================================================
 * VALIDATE MATCHER OUTPUT
 * ============================================================ */

private fun validateMatches(
    old: List<Grapheme>,
    new: List<Grapheme>,
    matches: List<Match>,
) {

    var previousOld =
        -1


    var previousNew =
        -1


    val seenOld =
        HashSet<Int>()


    val seenNew =
        HashSet<Int>()


    for (
        match in matches
    ) {

        require(
            match.oldIndex in
                old.indices
        ) {
            "Invalid oldIndex=${match.oldIndex}"
        }


        require(
            match.newIndex in
                new.indices
        ) {
            "Invalid newIndex=${match.newIndex}"
        }


        require(
            seenOld.add(
                match.oldIndex
            )
        ) {
            "oldIndex=${match.oldIndex} was matched more than once"
        }


        require(
            seenNew.add(
                match.newIndex
            )
        ) {
            "newIndex=${match.newIndex} was matched more than once"
        }


        require(
            old[
                match.oldIndex
            ].text ==
                new[
                    match.newIndex
                ].text
        ) {
            "Matcher matched different graphemes"
        }


        require(
            match.oldIndex >
                previousOld
        ) {
            "old match indices must be increasing"
        }


        require(
            match.newIndex >
                previousNew
        ) {
            "new match indices must be increasing"
        }


        previousOld =
            match.oldIndex


        previousNew =
            match.newIndex
    }
}


/* ============================================================
 * MEASUREMENT MODELS
 * ============================================================ */

private data class MeasuredGrapheme(
    val grapheme: Grapheme,
    val x: Float,
    val layout: TextLayoutResult,
)


private data class MeasuredWord(
    val fullLayout: TextLayoutResult?,
    val graphemes: List<MeasuredGrapheme>,
    val width: Float,
    val height: Float,
)


/* ============================================================
 * MEASURE WORD
 * ============================================================ */

private fun measureWord(
    text: String,
    graphemes: List<Grapheme>,
    textMeasurer: TextMeasurer,
    style: TextStyle,
): MeasuredWord {

    /*
     * Empty text:
     *
     * width = 0
     *
     * but preserve sensible text height.
     */
    if (
        text.isEmpty()
    ) {

        val probe =
            textMeasurer.measure(
                text =
                    AnnotatedString(
                        "Mg"
                    ),

                style =
                    style,

                softWrap =
                    false,

                maxLines =
                    1,

                constraints =
                    Constraints(),
            )


        return MeasuredWord(
            fullLayout =
                null,

            graphemes =
                emptyList(),

            width =
                0f,

            height =
                probe
                    .size
                    .height
                    .toFloat(),
        )
    }


    /*
     * Measure COMPLETE word first.
     *
     * We do NOT calculate:
     *
     * x = index * characterWidth
     *
     * because glyph widths differ.
     */
    val fullLayout =
        textMeasurer.measure(
            text =
                AnnotatedString(
                    text
                ),

            style =
                style,

            softWrap =
                false,

            maxLines =
                1,

            constraints =
                Constraints(),
        )


    val measuredGraphemes =
        graphemes.map {
                grapheme ->


            /*
             * Get position from actual Compose text layout.
             */
            val boundingBox =
                fullLayout.getBoundingBox(
                    grapheme.startOffset
                )


            /*
             * We need an independently drawable layout for
             * this grapheme because its alpha/X can animate.
             */
            val isolatedLayout =
                textMeasurer.measure(
                    text =
                        AnnotatedString(
                            grapheme.text
                        ),

                    style =
                        style,

                    softWrap =
                        false,

                    maxLines =
                        1,

                    constraints =
                        Constraints(),
                )


            MeasuredGrapheme(
                grapheme =
                    grapheme,

                x =
                    boundingBox.left,

                layout =
                    isolatedLayout,
            )
        }


    return MeasuredWord(
        fullLayout =
            fullLayout,

        graphemes =
            measuredGraphemes,

        width =
            fullLayout
                .size
                .width
                .toFloat(),

        height =
            fullLayout
                .size
                .height
                .toFloat(),
    )
}


/* ============================================================
 * DRAW STABLE WORD
 * ============================================================ */

private fun DrawScope.drawStableWord(
    word: MeasuredWord,
) {

    val layout =
        word.fullLayout
            ?: return


    drawText(
        textLayoutResult =
            layout,

        topLeft =
            Offset.Zero,
    )
}


/* ============================================================
 * DRAW TRANSITION
 * ============================================================ */

private fun DrawScope.drawTransition(
    plan: TransitionPlan,
    oldWord: MeasuredWord,
    newWord: MeasuredWord,
    exitAlpha: Float,
    moveProgress: Float,
    enterAlpha: Float,
) {

    /*
     * old index -> destination match
     */
    val matchByOldIndex =
        plan.matches
            .associateBy {
                it.oldIndex
            }


    /*
     * Destination indices already represented by surviving
     * old glyphs.
     */
    val matchedNewIndices =
        plan.matches
            .mapTo(
                HashSet()
            ) {
                it.newIndex
            }


    /* ========================================================
     * DRAW OLD GLYPH OBJECTS
     * ======================================================== */

    oldWord.graphemes
        .forEachIndexed {
                oldIndex,
                oldGrapheme ->


            val match =
                matchByOldIndex[
                    oldIndex
                ]


            if (
                match ==
                null
            ) {

                /* =============================================
                 * REMOVED GLYPH
                 *
                 * Position NEVER changes.
                 *
                 * Its actual alpha is exitAlpha.
                 *
                 * exitAlpha:
                 *
                 * 1 -> 0
                 * ============================================= */

                drawGrapheme(
                    grapheme =
                        oldGrapheme,

                    x =
                        oldGrapheme.x,

                    alpha =
                        exitAlpha,
                )

            } else {

                /* =============================================
                 * SURVIVOR
                 *
                 * This is the SAME rendered object.
                 *
                 * Alpha always = 1.
                 *
                 * Position:
                 *
                 * old X -> new X
                 * ============================================= */

                val destination =
                    newWord.graphemes[
                        match.newIndex
                    ]


                val animatedX =
                    lerp(
                        start =
                            oldGrapheme.x,

                        end =
                            destination.x,

                        fraction =
                            moveProgress,
                    )


                drawGrapheme(
                    grapheme =
                        oldGrapheme,

                    x =
                        animatedX,

                    alpha =
                        1f,
                )
            }
        }


    /* ========================================================
     * DRAW NEW-ONLY GLYPHS
     * ======================================================== */

    newWord.graphemes
        .forEachIndexed {
                newIndex,
                newGrapheme ->


            /*
             * Matched destination glyphs MUST NOT be drawn.
             *
             * Otherwise you get:
             *
             * old survivor
             * +
             * destination copy
             *
             * at the same time.
             */
            if (
                newIndex in
                matchedNewIndices
            ) {
                return@forEachIndexed
            }


            /* =============================================
             * INSERTED GLYPH
             *
             * Position is already final.
             *
             * Its actual alpha is enterAlpha.
             *
             * enterAlpha:
             *
             * 0 -> 1
             * ============================================= */

            drawGrapheme(
                grapheme =
                    newGrapheme,

                x =
                    newGrapheme.x,

                alpha =
                    enterAlpha,
            )
        }
}


/* ============================================================
 * DRAW ONE GRAPHEME
 * ============================================================ */

private fun DrawScope.drawGrapheme(
    grapheme: MeasuredGrapheme,
    x: Float,
    alpha: Float,
) {

    val safeAlpha =
        alpha.coerceIn(
            minimumValue =
                0f,

            maximumValue =
                1f,
        )


    /*
     * Completely invisible:
     * don't issue draw call.
     */
    if (
        safeAlpha <=
        0f
    ) {
        return
    }


    drawText(
        textLayoutResult =
            grapheme.layout,

        topLeft =
            Offset(
                x =
                    x,

                y =
                    0f,
            ),

        alpha =
            safeAlpha,
    )
}


/* ============================================================
 * LINEAR INTERPOLATION
 * ============================================================ */

private fun lerp(
    start: Float,
    end: Float,
    fraction: Float,
): Float {

    val progress =
        fraction.coerceIn(
            minimumValue =
                0f,

            maximumValue =
                1f,
        )


    return start +
        (
            end -
                start
        ) *
        progress
}
